# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://adviser:CHANGE_ME@127.0.0.1:5432/adviser_db"
# 路径末尾须为数据库名 adviser_db（不要写成 /adviser）。密码中的特殊字符需 URL 编码。
# 全新生产：`prisma migrate deploy` 从仓库从零建库表；曾因迁移失败半截时请先备份后清空/重建该库再执行。
# 若本机连不上可改用 127.0.0.1，避免 localhost 走 IPv6/socket 与 pg_hba 不一致。

# ─────────────────────────────────────────────
# Auth.js v5
# ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"
# Auth.js v5：须与浏览器访问的协议+域名一致（无尾部斜杠），否则会 UntrustedHost
AUTH_URL="https://yourdomain.com"
# 仅 HTTP 时改为 http://yourdomain.com
# 若暂无法用固定域名（或多域名），可设为 true（依赖反向代理传入的 Host）
AUTH_TRUST_HOST="false"
# 兼容旧名；未设置 AUTH_URL 时部分工具仍读此项
NEXTAUTH_URL="https://yourdomain.com"

# ─────────────────────────────────────────────
# Cloudflare R2 (file storage)
# ─────────────────────────────────────────────
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="adviser-docs"
R2_PUBLIC_URL="https://your-r2-bucket.your-account.r2.cloudflarestorage.com"

# ─────────────────────────────────────────────
# Resend (transactional email)
# ─────────────────────────────────────────────
RESEND_API_KEY="re_CHANGE_ME"
EMAIL_FROM="noreply@yourdomain.com"

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NODE_ENV="production"
# （可选）Next standalone 监听地址，默认等价 0.0.0.0。云上若报错 getaddrinfo ENOTFOUND：<实例ID>，
# 多为系统 HOSTNAME 被误用作监听地址；可在本行取消注释：NEXT_HOST_BIND=0.0.0.0

# Optional: comma-separated IP allowlist for admin routes
# Leave empty to allow all IPs
ADMIN_ALLOWLIST_IPS=""

# ─────────────────────────────────────────────
# Sentry (error monitoring) — optional
# ─────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
