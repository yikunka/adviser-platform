# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://adviser:CHANGE_ME@localhost:5432/adviser_db"

# ─────────────────────────────────────────────
# Auth.js v5
# ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"
# Base URL of the app (no trailing slash)
NEXTAUTH_URL="https://yourdomain.com"

# ─────────────────────────────────────────────
# Cloudflare R2 (file storage)
# ─────────────────────────────────────────────
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="adviser-docs"
R2_PUBLIC_URL="https://your-r2-bucket.your-account.r2.cloudflarestorage.com"

# ─────────────────────────────────────────────
# Resend (transactional email)
# ─────────────────────────────────────────────
RESEND_API_KEY="re_CHANGE_ME"
EMAIL_FROM="noreply@yourdomain.com"

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NODE_ENV="production"

# Optional: comma-separated IP allowlist for admin routes
# Leave empty to allow all IPs
ADMIN_ALLOWLIST_IPS=""

# ─────────────────────────────────────────────
# Sentry (error monitoring) — optional
# ─────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
