# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
# Local dev: `docker compose up db -d` (default host port 5432).
POSTGRES_PASSWORD="devpassword"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://adviser:devpassword@127.0.0.1:5432/adviser_db"
# 路径末尾须为数据库名 adviser_db（不要写成 /adviser）。密码中的特殊字符需 URL 编码。
# 全新生产：`prisma migrate deploy` 从仓库从零建库表；曾因迁移失败半截时请先备份后清空/重建该库再执行。
# 若本机连不上可改用 127.0.0.1，避免 localhost 走 IPv6/socket 与 pg_hba 不一致。

# ─────────────────────────────────────────────
# Auth.js v5
# ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"
# 须与浏览器访问的协议+主机一致（含 http/https，不要尾部斜杠），否则会 UntrustedHost；本地示例 http://localhost:3000
AUTH_URL="https://yourdomain.com"
# 仅 HTTP 时改为 http://yourdomain.com
# 若暂无法用固定域名（或多域名），可设为 true（依赖反向代理传入的 Host）
AUTH_TRUST_HOST="false"
# 兼容旧名；未设置 AUTH_URL 时部分工具仍读此项
NEXTAUTH_URL="https://yourdomain.com"

# ─────────────────────────────────────────────
# 阿里云 OSS (file storage + static CDN)
# ─────────────────────────────────────────────
# Local dev: leave OSS blank and set LOCAL_UPLOADS_DIR (default ./uploads).
# Files are served via GET /api/files?key=<storageKey> — no OSS account needed.
# LOCAL_UPLOADS_DIR="uploads"
# USE_LOCAL_STORAGE="true"   # force local even if OSS vars are set (dev only)
#
# Production: configure OSS below and do NOT set LOCAL_UPLOADS_DIR or USE_LOCAL_STORAGE.
# (If LOCAL_UPLOADS_DIR is left in .env, production still uses OSS when OSS_* are set.)
# OSS_REGION      阿里云地域，例如 cn-hangzhou（不含 "oss-" 前缀）
# OSS_BUCKET      已在控制台创建的 Bucket 名称
# OSS_CDN_URL     静态资源 CDN 入口（Next.js assetPrefix），deploy 时需已同步好静态资源
#                 示例（直接访问）：https://<bucket>.oss-cn-hangzhou.aliyuncs.com
#                 示例（自定义域）：https://cdn.yourdomain.com
#
# 用法：
#   1. OSS 控制台创建 Bucket，开启公共读（静态资源用）
#   2. 创建 RAM 子账号 AccessKey，授予该 Bucket 读写权限
#   3. 填入下方变量，deploy.sh 在 next build 后自动运行 scripts/sync-oss-static.mjs
OSS_REGION="cn-hangzhou"
OSS_ACCESS_KEY_ID="your_oss_access_key_id"
OSS_ACCESS_KEY_SECRET="your_oss_access_key_secret"
OSS_BUCKET="your-bucket-name"
OSS_CDN_URL="https://your-bucket-name.oss-cn-hangzhou.aliyuncs.com"
# NEXT_PUBLIC_ prefix makes this available at build-time AND client-side.
# Set it to the same value as OSS_CDN_URL (both are needed):
#   OSS_CDN_URL     — used by next.config.ts (assetPrefix) and deploy scripts
#   NEXT_PUBLIC_OSS_CDN_URL — used by ossImg() helper in React components
NEXT_PUBLIC_OSS_CDN_URL="https://your-bucket-name.oss-cn-hangzhou.aliyuncs.com"

# Database backup to OSS (scripts/backup-db.sh — cron on server, not in app)
# BACKUP_OSS_PREFIX=backups/db
# BACKUP_RETAIN_COUNT=10

# ─────────────────────────────────────────────
# 阿里百炼 / DashScope (company document analysis)
# ─────────────────────────────────────────────
# Used by the admin "New company" document analyzer with qwen3.5-flash.
# NAR1 multi-page PDF analysis also uses this key (default timeout 180s, override with NAR1_BAILIAN_TIMEOUT_MS).
# If omitted, the UI still attaches uploaded company documents and applies
# lightweight filename/PDF-text hints where possible.
DASHSCOPE_API_KEY="sk_CHANGE_ME"

# ─────────────────────────────────────────────
# Resend (transactional email)
# ─────────────────────────────────────────────
RESEND_API_KEY="re_CHANGE_ME"
EMAIL_FROM="noreply@yourdomain.com"

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NODE_ENV="production"
# （可选）Next standalone 监听地址，默认等价 0.0.0.0。云上若报错 getaddrinfo ENOTFOUND：<实例ID>，
# 多为系统 HOSTNAME 被误用作监听地址；可在本行取消注释：NEXT_HOST_BIND=0.0.0.0

# Optional: comma-separated IP allowlist for admin routes
# Leave empty to allow all IPs
ADMIN_ALLOWLIST_IPS=""

# ─────────────────────────────────────────────
# Sentry (error monitoring) — optional
# ─────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
