generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum ProcessKitStatus {
  DRAFT    // 草稿
  ACTIVE   // 已启用
  ARCHIVED // 已归档
}

enum ProcessTestType {
  PERFORMANCE       // 性能测试
  DURABILITY        // 耐久性测试
  ADHESION          // 附着力测试
  COLOR_STABILITY   // 色牢度测试
  BOND_STRENGTH     // 粘结强度测试
  OTHER             // 其他
}

enum ProcessTestResult {
  PASSED  // 通过
  FAILED  // 未通过
  PENDING // 待测试
}

enum UserRole {
  CLIENT
  STAFF
  COMPLIANCE
  SUPER_ADMIN
}

enum Platform {
  ADVISER
  SFS_DIAMOND
  COSMICOAT
}

enum CompanyStatus {
  ACTIVE
  DORMANT
  STRUCK_OFF
  DEREGISTERED
}

enum ServiceTier {
  BASIC
  PROFESSIONAL
  PREMIUM
}

enum KYCStatus {
  DRAFT
  SUBMITTED
  PENDING_INFO
  APPROVED
  REJECTED
}

enum DocumentType {
  CI
  BR
  AA
  NNC1
  ROD
  ROM
  ROSC
  AR
  NAR1
  AUDIT_TAX
  DDR
  RESOLUTION
  MINUTES
  KYC
  OTHER
}

enum AMLEntityType {
  INDIVIDUAL
  ENTITY
}

enum AMLListFormat {
  XML
  CSV
  XLSX
  JSON
}

enum AMLCheckResult {
  CLEAR
  WEAK_HIT
  POTENTIAL_HIT
  STRONG_HIT
}

enum AMLCheckTrigger {
  SCHEDULED
  MANUAL
  KYC_SUBMIT
}

enum AMLAlertResolution {
  PENDING
  FALSE_POSITIVE
  CONFIRMED
  ESCALATED
}

enum AMLSubjectType {
  KEY_PERSON
  COMPANY
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum DDRRecommendation {
  RECOMMEND
  NOT_RECOMMEND
  FURTHER_REVIEW
}

enum ShareholderChangeType {
  TRANSFER
  NEW_ALLOTMENT
  REDEMPTION
  NAME_CHANGE
}

enum ShareClass {
  ORDINARY
  PREFERENCE
  OTHER
}

enum ShareTransactionType {
  ALLOTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum DirectorIDType {
  HKID
  PASSPORT
  OTHER
}

enum DirectorStatus {
  ACTIVE
  CEASED
}

enum MemberStatus {
  ACTIVE
  TRANSFERRED_OUT
}

enum ChangeStatus {
  PENDING
  PROCESSING
  COMPLETED
}

enum FilingStatus {
  NOT_STARTED
  IN_PREPARATION
  FILED
  OVERDUE
}

enum OrderType {
  INCORPORATION
  REGISTERED_ADDRESS
  ANNUAL_RETURN
  ACCOUNTING
  ADVISORY
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum NotificationType {
  KYC_STATUS_CHANGE
  AML_ALERT
  ANNUAL_RETURN_DUE
  DOCUMENT_READY
  GENERAL
}

enum EmploymentStatus {
  EMPLOYED
  SELF_EMPLOYED
  RETIRED
  UNEMPLOYED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

// ─────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  nameEn         String
  nameZh         String?
  phone          String?
  mailingAddress String?
  role           UserRole  @default(CLIENT)
  platform       Platform  @default(ADVISER)
  /// Admin Console: which commercial platforms this staff user may operate.
  adminPlatforms Platform[] @default([])
  /// Admin Console: granular menu keys (see src/lib/auth/admin-access.ts).
  adminMenuKeys  String[]  @default([])
  isActive       Boolean   @default(true)
  emailVerified  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  verificationTokens VerificationToken[]
  clientCompanies    Company[]           @relation("ClientCompany")
  assignedCompanies  Company[]           @relation("AssignedStaff")
  companyStaffAssignments CompanyStaffAssignment[]
  createdCompanyStaffAssignments CompanyStaffAssignment[] @relation("CompanyStaffAssignmentCreator")
  createdFinancialReportGroups FinancialReportGroup[] @relation("FinancialReportGroupCreator")
  uploadedDocuments  Document[]
  kycReviews         KeyPerson[]         @relation("KYCReviewer")
  kycSubmissions     KeyPerson[]         @relation("ClientKycSubmissions")
  amlChecksTriggered AMLCheck[]          @relation("AMLCheckTrigger")
  amlAlertsReviewed  AMLAlert[]          @relation("AMLAlertReviewer")
  auditLogs          AuditLog[]
  notifications      Notification[]
  processedChanges   ShareholderChange[]
  processedAddress   AddressChange[]
  processedFilings   AnnualFiling[]
  orders             ServiceOrder[]
  sfsOrders          SfsOrder[]
  cosJournalEntries  CosTableJournalEntry[]
  financialJournalEntries JournalEntry[] @relation("FinancialJournalCreatedBy")
  invoicesCreated         Invoice[]     @relation("InvoiceCreatedBy")
  sfsInvoicesCreated      SfsInvoice[]  @relation("SfsInvoiceCreatedBy")

  createdProcessKits CosProcessKit[]  @relation("ProcessKitCreator")
  updatedProcessKits CosProcessKit[]  @relation("ProcessKitUpdater")
  testedProcessKits  CosProcessTest[] @relation("ProcessTestTester")

  @@map("users")
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
}

// ─────────────────────────────────────────────
// COMPANIES
// ─────────────────────────────────────────────

model Company {
  id                    String        @id @default(cuid())
  nameEn                String
  nameZh                String?
  companyNumber         String?       @unique
  companyType           String?
  companyCode           String?       @unique
  dateOfIncorporation   DateTime?
  registeredAddress     String?
  businessNature        String?
  financialYearEndMonth Int?
  annualReturnDate      DateTime?
  businessRegNumber     String?
  brExpiryDate          DateTime?
  status                CompanyStatus @default(ACTIVE)
  serviceTier           ServiceTier   @default(BASIC)
  financialEnabled      Boolean       @default(true)
  internalNotes         String?
  deletedAt             DateTime?
  clientUserId          String?
  /// Lowercased email: company is pre-assigned until a CLIENT registers with this email
  pendingClientEmail    String?
  assignedStaffId       String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  clientUser    User?               @relation("ClientCompany", fields: [clientUserId], references: [id])
  assignedStaff User?               @relation("AssignedStaff", fields: [assignedStaffId], references: [id])

  directors              Director[]
  members                Member[]
  significantControllers SignificantController[]
  designatedReps         DesignatedRepresentative[]
  documents              Document[]
  fileCases              CompanyFileCase[]
  amlChecks              AMLCheck[]                 @relation("CompanyAMLCheck")
  dueDiligenceReports    DueDiligenceReport[]
  riskAssessments        RiskAssessmentAnswer[]
  annualFilings          AnnualFiling[]
  shareholderChanges     ShareholderChange[]
  addressChanges         AddressChange[]
  keyPersonLinks         CompanyKeyPerson[]
  serviceOrders          ServiceOrder[]
  auditLogs              AuditLog[]                 @relation("CompanyAuditLog")
  finAccounts            FinAccount[]
  journalEntries         JournalEntry[]
  ledgerEntries          Ledger[]
  invoices               Invoice[]
  staffAssignments       CompanyStaffAssignment[]
  reportGroupMemberships FinancialReportGroupCompany[]

  @@index([pendingClientEmail])
  @@map("companies")
}

/// Staff users who can operate a company. This augments legacy Company.assignedStaffId.
model CompanyStaffAssignment {
  id          String   @id @default(cuid())
  companyId   String
  userId      String
  createdById String?
  createdAt   DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("CompanyStaffAssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([companyId, userId])
  @@index([userId])
  @@index([createdById])
  @@map("company_staff_assignments")
}

/// Optional reporting-only portfolio for consolidated multi-company reports.
model FinancialReportGroup {
  id          String   @id @default(cuid())
  name        String
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation("FinancialReportGroupCreator", fields: [createdById], references: [id], onDelete: SetNull)
  companies FinancialReportGroupCompany[]

  @@index([name])
  @@index([createdById])
  @@map("financial_report_groups")
}

model FinancialReportGroupCompany {
  id        String   @id @default(cuid())
  groupId   String
  companyId String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  group   FinancialReportGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  company Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([groupId, companyId])
  @@index([companyId])
  @@index([groupId, sortOrder])
  @@map("financial_report_group_companies")
}

// ─────────────────────────────────────────────
// REGISTER OF DIRECTORS (ROD)
// ─────────────────────────────────────────────

model Director {
  id                String         @id @default(cuid())
  companyId         String
  keyPersonId       String?
  nameEn            String
  nameZh            String?
  dateOfAppointment DateTime
  dateAsReserve     DateTime?
  dateOfCessation   DateTime?
  addressForService String
  dateOfBirth       DateTime?
  placeOfBirth      String?
  nationality       String?
  idType            DirectorIDType?
  idNumber          String?
  countryOfIssuance String?
  isCorporation     Boolean        @default(false)
  corpRegNumber     String?
  corpRegPlace      String?
  status            DirectorStatus @default(ACTIVE)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  keyPerson KeyPerson? @relation(fields: [keyPersonId], references: [id], onDelete: SetNull)

  @@index([keyPersonId])
  @@map("directors")
}

// ─────────────────────────────────────────────
// REGISTER OF MEMBERS (ROM)
// ─────────────────────────────────────────────

model Member {
  id                String       @id @default(cuid())
  companyId         String
  keyPersonId       String?
  nameEn            String
  nameZh            String?
  shareClass        ShareClass   @default(ORDINARY)
  registeredAddress String
  occupation        String?
  status            MemberStatus @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  keyPerson         KeyPerson?         @relation(fields: [keyPersonId], references: [id], onDelete: SetNull)
  shareTransactions ShareTransaction[]

  @@index([keyPersonId])
  @@map("members")
}

model ShareTransaction {
  id                     String               @id @default(cuid())
  memberId               String
  transactionType        ShareTransactionType
  transactionDate        DateTime
  allotmentTransferNo    String?
  sharesAcquired         Int?
  sharesTransferred      Int?
  sharesHeld             Int
  certificateNo          String?
  distinctiveNosFrom     Int?
  distinctiveNosTo       Int?
  amountPaid             Decimal?             @db.Decimal(18, 2)
  certificateSurrendered       String?
  certificateSurrenderedShares Int?
  balanceCertificateNo         String?
  balanceCertificateShares     Int?
  balanceDistinctiveNosFrom    Int?
  balanceDistinctiveNosTo      Int?
  createdAt                    DateTime             @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("share_transactions")
}

// ─────────────────────────────────────────────
// REGISTER OF SIGNIFICANT CONTROLLERS (ROSC)
// ─────────────────────────────────────────────

model SignificantController {
  id                    String    @id @default(cuid())
  companyId             String
  keyPersonId           String?
  entryDate             DateTime
  nameEn                String
  nameZh                String?
  correspondenceAddress String?
  idType                DirectorIDType?
  idPassportNo          String?
  issuingCountry        String?
  natureOfControl       String?
  becomingDate          DateTime
  cessationDate         DateTime?
  isLegalEntity         Boolean   @default(false)
  legalEntityRegNo      String?
  legalEntityGovLaw     String?
  remarks               String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  keyPerson KeyPerson? @relation(fields: [keyPersonId], references: [id], onDelete: SetNull)

  @@index([keyPersonId])
  @@map("significant_controllers")
}

model DesignatedRepresentative {
  id            String    @id @default(cuid())
  companyId     String
  entryDate     DateTime
  name          String
  address       String?
  capacity      String?
  telFax        String?
  becomingDate  DateTime
  cessationDate DateTime?
  remarks       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("designated_representatives")
}

// ─────────────────────────────────────────────
// KEY PERSONS & KYC
// ─────────────────────────────────────────────

model KeyPerson {
  id               String            @id @default(cuid())
  kycCode          String?           @unique @map("kyc_code")
  /// Client who created this KYC (portal); distinct from company-linked key persons
  submittedByUserId String?
  titlePrefix      String?
  firstName        String?
  lastName         String?
  otherName        String?
  nameEn           String
  nameZh           String?
  idType           String?
  idNumber         String?
  placeOfIssue     String?
  placeOfBirth     String?
  idExpiryDate     DateTime?
  dateOfBirth      DateTime?
  nationality      String?
  homeAddress      String?
  contactAddress   String?
  homePhone        String?
  workPhone        String?
  mobile           String?
  wechat           String?
  email            String?
  isUsCitizen      Boolean?
  isPep            Boolean?
  emergencyContact String?
  employmentStatus EmploymentStatus?
  employerName     String?
  employerAddress  String?
  businessNatures  String[]
  position         String?
  workingYears     Int?
  sourceOfFunds    String?
  sourcesOfWealth  String[]
  annualIncome     String?
  netAssetValue    String?
  assetItems       String[]
  declarationSigned Boolean          @default(false)
  signatureName    String?
  declarationDate  DateTime?
  kycStatus        KYCStatus         @default(DRAFT)
  kycApprovedById  String?
  kycApprovedAt    DateTime?
  kycExpiryDate    DateTime?
  kycRejectionReason String?
  amlLastChecked   DateTime?
  amlRiskLevel     RiskLevel?
  amlAlert         Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  submittedByUser User?              @relation("ClientKycSubmissions", fields: [submittedByUserId], references: [id])
  kycApprovedBy User?              @relation("KYCReviewer", fields: [kycApprovedById], references: [id])
  kycDocuments  KYCDocument[]
  companyLinks  CompanyKeyPerson[]
  amlChecks     AMLCheck[]         @relation("KeyPersonAMLCheck")
  directors     Director[]
  members       Member[]
  significantControllers SignificantController[]

  @@index([submittedByUserId])
  @@map("key_persons")
}

model KYCDocument {
  id              String   @id @default(cuid())
  keyPersonId     String
  documentType    String
  fileName        String
  storageKey      String
  mimeType        String
  fileSize        Int
  status          String   @default("PENDING")
  rejectionReason String?
  uploadedAt      DateTime @default(now())
  verifiedAt      DateTime?

  keyPerson KeyPerson @relation(fields: [keyPersonId], references: [id], onDelete: Cascade)

  @@map("kyc_documents")
}

model CompanyKeyPerson {
  id          String   @id @default(cuid())
  companyId   String
  keyPersonId String
  roles       String[]
  createdAt   DateTime @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  keyPerson KeyPerson @relation(fields: [keyPersonId], references: [id], onDelete: Cascade)

  @@unique([companyId, keyPersonId])
  @@map("company_key_persons")
}

// ─────────────────────────────────────────────
// DOCUMENTS
// ─────────────────────────────────────────────

model Document {
  id            String       @id @default(cuid())
  companyId     String?
  documentType  DocumentType
  name          String
  storageKey    String
  mimeType      String
  fileSize      Int
  uploadedById  String
  fileCaseId    String?
  caseFileRole  String?
  customDocumentType String?
  effectiveDate DateTime?
  submissionDate DateTime?
  expiryDate    DateTime?
  version       Int          @default(1)
  notes         String?
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  company    Company? @relation(fields: [companyId], references: [id])
  uploadedBy User     @relation(fields: [uploadedById], references: [id])
  fileCase   CompanyFileCase? @relation(fields: [fileCaseId], references: [id], onDelete: SetNull)

  shareholderChangeDocs ShareholderChangeDocument[]
  addressChangeDocs     AddressChangeDocument[]
  annualFilingDocs      AnnualFilingDocument[]

  @@map("documents")
}

model CompanyFileCase {
  id        String    @id @default(cuid())
  companyId String
  name      String
  caseDate  DateTime?
  remark    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([companyId])
  @@map("company_file_cases")
}

// ─────────────────────────────────────────────
// AML ENGINE
// ─────────────────────────────────────────────

model AMLSource {
  id          String        @id @default(cuid())
  seqNo       Int           @unique
  nameEn      String
  nameZh      String
  sourceUrl   String
  format      AMLListFormat
  isActive    Boolean       @default(true)
  lastFetched DateTime?
  createdAt   DateTime      @default(now())

  records AMLRecord[]

  @@map("aml_sources")
}

model AMLRecord {
  id              String        @id @default(cuid())
  sourceId        String
  listVersionDate DateTime
  entityType      AMLEntityType
  primaryName     String
  aliases         String[]
  dateOfBirth     DateTime?
  nationality     String?
  gender          String?
  placeOfBirth    String?
  addresses       Json?
  idNumbers       Json?
  listingReason   String?
  listingDate     DateTime?
  rawData         Json?
  recordHash      String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  source    AMLSource  @relation(fields: [sourceId], references: [id])
  amlAlerts AMLAlert[]

  @@unique([sourceId, recordHash])
  @@index([primaryName])
  @@map("aml_records")
}

model AMLCheck {
  id            String          @id @default(cuid())
  subjectType   AMLSubjectType
  keyPersonId   String?
  companyId     String?
  checkedAt     DateTime        @default(now())
  trigger       AMLCheckTrigger
  triggeredById String?
  result        AMLCheckResult
  matches       Json?

  keyPerson   KeyPerson? @relation("KeyPersonAMLCheck", fields: [keyPersonId], references: [id])
  company     Company?   @relation("CompanyAMLCheck", fields: [companyId], references: [id])
  triggeredBy User?      @relation("AMLCheckTrigger", fields: [triggeredById], references: [id])

  @@map("aml_checks")
}

model AMLAlert {
  id           String             @id @default(cuid())
  amlRecordId  String
  subjectType  AMLSubjectType
  keyPersonId  String?
  companyId    String?
  matchScore   Float?
  result       AMLCheckResult
  resolution   AMLAlertResolution @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  amlRecord  AMLRecord @relation(fields: [amlRecordId], references: [id])
  reviewedBy User?     @relation("AMLAlertReviewer", fields: [reviewedById], references: [id])

  @@map("aml_alerts")
}

// ─────────────────────────────────────────────
// DUE DILIGENCE REPORTS
// ─────────────────────────────────────────────

model DueDiligenceReport {
  id                 String            @id @default(cuid())
  companyId          String
  reportDate         DateTime          @default(now())
  overallRiskLevel   RiskLevel?
  recommendation     DDRRecommendation?
  recommendationNote String?
  recommendedById    String?
  recommendedAt      DateTime?
  approvalStatus     Boolean?
  approvalNote       String?
  approvedById       String?
  approvedAt         DateTime?
  storageKey         String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  company         Company                @relation(fields: [companyId], references: [id])
  riskAssessments RiskAssessmentAnswer[]

  @@map("due_diligence_reports")
}

model RiskAssessmentAnswer {
  id          String   @id @default(cuid())
  companyId   String
  ddrId       String?
  questionKey String
  category    String
  answer      String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company             @relation(fields: [companyId], references: [id])
  ddr     DueDiligenceReport? @relation(fields: [ddrId], references: [id])

  @@unique([companyId, ddrId, questionKey])
  @@map("risk_assessment_answers")
}

// ─────────────────────────────────────────────
// CORPORATE CHANGES
// ─────────────────────────────────────────────

model ShareholderChange {
  id              String                @id @default(cuid())
  companyId       String
  changeType      ShareholderChangeType
  effectiveDate   DateTime
  transferorId    String?
  transfereeId    String?
  numberOfShares  Int?
  shareClass      String?
  consideration   Decimal?              @db.Decimal(18, 2)
  filedWithCR     Boolean               @default(false)
  filingDate      DateTime?
  filingReference String?
  processedById   String?
  status          ChangeStatus          @default(PENDING)
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  company     Company   @relation(fields: [companyId], references: [id])
  processedBy User?     @relation(fields: [processedById], references: [id])
  documents   ShareholderChangeDocument[]

  @@map("shareholder_changes")
}

model ShareholderChangeDocument {
  changeId   String
  documentId String

  change   ShareholderChange @relation(fields: [changeId], references: [id], onDelete: Cascade)
  document Document          @relation(fields: [documentId], references: [id])

  @@id([changeId, documentId])
  @@map("shareholder_change_documents")
}

model AddressChange {
  id              String       @id @default(cuid())
  companyId       String
  previousAddress String
  newAddress      String
  effectiveDate   DateTime
  noticeToCR      Boolean      @default(false)
  nnd1FilingDate  DateTime?
  nnd1Reference   String?
  processedById   String?
  status          ChangeStatus @default(PENDING)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  company     Company @relation(fields: [companyId], references: [id])
  processedBy User?   @relation(fields: [processedById], references: [id])
  documents   AddressChangeDocument[]

  @@map("address_changes")
}

model AddressChangeDocument {
  changeId   String
  documentId String

  change   AddressChange @relation(fields: [changeId], references: [id], onDelete: Cascade)
  document Document      @relation(fields: [documentId], references: [id])

  @@id([changeId, documentId])
  @@map("address_change_documents")
}

// ─────────────────────────────────────────────
// ANNUAL FILINGS
// ─────────────────────────────────────────────

model AnnualFiling {
  id               String       @id @default(cuid())
  companyId        String
  annualReturnDate DateTime
  financialYearEnd DateTime?
  filingDeadline   DateTime?
  status           FilingStatus @default(NOT_STARTED)
  filedDate        DateTime?
  filingReference  String?
  processedById    String?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  company     Company @relation(fields: [companyId], references: [id])
  processedBy User?   @relation(fields: [processedById], references: [id])
  documents   AnnualFilingDocument[]

  @@map("annual_filings")
}

model AnnualFilingDocument {
  filingId   String
  documentId String

  filing   AnnualFiling @relation(fields: [filingId], references: [id], onDelete: Cascade)
  document Document     @relation(fields: [documentId], references: [id])

  @@id([filingId, documentId])
  @@map("annual_filing_documents")
}

// ─────────────────────────────────────────────
// SERVICE ORDERS
// ─────────────────────────────────────────────

model ServiceOrder {
  id        String      @id @default(cuid())
  userId    String
  companyId String?
  orderType OrderType
  status    OrderStatus @default(PENDING)
  formData  Json
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@map("service_orders")
}

// ─────────────────────────────────────────────
// INVOICES (Adviser — customer billing)
// ─────────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  companyId     String
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime
  dueDate       DateTime?
  currency      String        @default("HKD")
  billToName    String
  billToAddress String?
  billToEmail   String?
  subtotal      Decimal       @db.Decimal(18, 2)
  taxRate       Decimal       @default(0) @db.Decimal(5, 4)
  taxAmount     Decimal       @default(0) @db.Decimal(18, 2)
  total         Decimal       @db.Decimal(18, 2)
  notes         String?
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy User              @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  lineItems InvoiceLineItem[]

  @@index([companyId])
  @@index([status])
  @@index([issueDate])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  sortOrder   Int     @default(0)
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 4)
  unitPrice   Decimal @db.Decimal(18, 2)
  amount      Decimal @db.Decimal(18, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, sortOrder])
  @@map("invoice_line_items")
}

// ─────────────────────────────────────────────
// AUDIT LOG (append-only)
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userRole   String?
  action     String
  entityType String
  entityId   String?
  companyId  String?
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id])
  company Company? @relation("CompanyAuditLog", fields: [companyId], references: [id])

  @@index([entityType, entityId])
  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id              String           @id @default(cuid())
  userId          String
  type            NotificationType
  title           String
  message         String
  relatedEntityId String?
  isRead          Boolean          @default(false)
  createdAt       DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// SFS DIAMOND — ORDERS
// ─────────────────────────────────────────────

enum SfsOrderStatus {
  PENDING
  QUOTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model SfsOrder {
  id        String         @id @default(cuid())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  status    SfsOrderStatus @default(PENDING)

  // Linked user
  userId String?
  user   User?  @relation(fields: [userId], references: [id])

  // Part 1 — Client Information
  date           String
  sampleCode     String?
  memorialName   String
  relationship   String
  clientName     String
  contactNumber  String
  email          String
  mailingAddress String

  // Part 2 — Source Material
  sourceType     String
  sourceOther    String?
  remarks        String?
  mailingPackage String

  // Part 3 — Color
  color String

  // Part 4 & 5 — Diamond line items
  diamonds Json

  // Milestone dates (set by admin)
  sampleReceivedAt      DateTime?
  chemTransformStartAt  DateTime?
  chemTransformEndAt    DateTime?
  cvdStartAt            DateTime?
  cvdExpectedEndAt      DateTime?
  cvdEndAt              DateTime?
  craftingStartAt       DateTime?
  craftingEndAt         DateTime?
  igiCertificationAt    DateTime?
  jewelrySettingStartAt DateTime?
  jewelrySettingEndAt   DateTime?
  packagingAt           DateTime?
  deliveryAt            DateTime?
  deliveryDetails       String?

  // Admin notes
  adminNotes     String?
  customerRemark String?

  steps    SfsOrderStep[]
  invoices SfsInvoice[]

  @@index([userId])
  @@index([email])
  @@index([status, createdAt])
  @@map("sfs_orders")
}

model SfsOrderStep {
  id         String   @id @default(cuid())
  orderId    String
  phase      String   // CHEM_TRANSFORM | CVD | CRAFTING
  stepNumber Int
  recordedAt DateTime
  particular String
  notes      String?
  fileKeys   String[]
  createdAt  DateTime @default(now())

  order SfsOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, phase])
  @@map("sfs_order_steps")
}

// ─────────────────────────────────────────────
// SFS DIAMOND — INVOICES
// ─────────────────────────────────────────────

model SfsInvoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  orderId       String?
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime
  dueDate       DateTime?
  currency      String        @default("HKD")
  billToName    String
  billToAddress String?
  billToEmail   String?
  billToPhone   String?
  subtotal      Decimal       @db.Decimal(18, 2)
  taxRate       Decimal       @default(0) @db.Decimal(5, 4)
  taxAmount     Decimal       @default(0) @db.Decimal(18, 2)
  total         Decimal       @db.Decimal(18, 2)
  notes         String?
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order     SfsOrder?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy User                 @relation("SfsInvoiceCreatedBy", fields: [createdById], references: [id])
  lineItems SfsInvoiceLineItem[]

  @@index([orderId])
  @@index([status])
  @@index([issueDate])
  @@map("sfs_invoices")
}

model SfsInvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  sortOrder   Int     @default(0)
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 4)
  unitPrice   Decimal @db.Decimal(18, 2)
  amount      Decimal @db.Decimal(18, 2)

  invoice SfsInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, sortOrder])
  @@map("sfs_invoice_line_items")
}

// ─────────────────────────────────────────────
// CosmoCoat — PRODUCTS
// ─────────────────────────────────────────────

/// Factory product categories — hierarchical taxonomy (max 3 levels)
model CosTableProductCategory {
  id               String   @id @default(cuid())
  name             String
  description      String   @default("")
  parentCategoryId String?
  slug             String   @unique
  image            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  parent   CosTableProductCategory?  @relation("ProductCategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  children CosTableProductCategory[] @relation("ProductCategoryHierarchy")
  factoryProducts CosTableFactoryProduct[]

  @@index([parentCategoryId])
  @@index([isActive])
  @@map("cos_table_product_categories")
}

model CosTableProduct {
  id        String   @id @default(cuid())
  pid       String   @unique
  type      String
  title     String
  teaser    String   @default("")
  detail    String   @db.Text
  imagePath String
  irCuringTime        Int?     @map("ir_curing_time")
  irCuringTemp        Int?     @map("ir_curing_temp")
  uvCuringIntensity   Decimal? @db.Decimal(8, 2) @map("uv_curing_intensity")
  uvCuringUnit        String?  @map("uv_curing_unit")
  viscosity           Decimal? @db.Decimal(10, 3) @map("viscosity")
  viscosityUnit       String?  @map("viscosity_unit")
  mixingRatio         String?  @map("mixing_ratio")
  compatibleProducts  String?  @map("compatible_products")
  requiresCompatibility Boolean @default(false) @map("requires_compatibility")
  sortOrder Int      @default(0)
  isFeatured Boolean @default(false)
  isVisible  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, sortOrder])
  @@index([isFeatured, sortOrder])
  @@index([isVisible, sortOrder])
  @@map("cos_table_products")
}

// ─────────────────────────────────────────────
// CosmoCoat — RAW MATERIALS (原料)
// ─────────────────────────────────────────────

model CosTableRawMaterial {
  id        String   @id @default(cuid())
  category  String
  attributeCode String
  productionCode String @unique
  huaxingCode String @default("")
  name      String

  primarySupplierCode    String  @default("")
  primarySupplierName    String  @default("")
  primaryPackageKg       Decimal? @db.Decimal(12, 2)
  primaryPricePerKg      Decimal? @db.Decimal(12, 4)
  primaryTaxIncluded     String  @default("")
  primaryFreightIncluded String  @default("")
  primaryNotes           String  @default("")

  secondarySupplierCode    String  @default("")
  secondarySupplierName    String  @default("")
  secondaryPackageKg       Decimal? @db.Decimal(12, 2)
  secondaryPricePerKg      Decimal? @db.Decimal(12, 4)
  secondaryTaxIncluded     String  @default("")
  secondaryFreightIncluded String  @default("")
  secondaryNotes           String  @default("")

  // TDS (Technical Data Sheet) and MSDS (Material Safety Data Sheet) file keys
  tdsFileKey  String? @map("tds_file_key")
  msdsFileKey String? @map("msds_file_key")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([attributeCode])
  @@index([name])
  @@map("cos_table_raw_materials")

  recipeItems CosTableRecipeItem[]
  colorFormulaItems CosTableColorFormulaItem[]
  productionOrderItems CosTableProductionOrderItem[]
}

// ─────────────────────────────────────────────
// CosmoCoat — RECIPES (配方)
// ─────────────────────────────────────────────

model CosTableRecipeCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipes CosTableRecipe[]

  @@index([sortOrder])
  @@map("cos_table_recipe_categories")
}

model CosTableRecipe {
  id            String   @id @default(cuid())
  categoryId    String
  code          String   @unique
  name          String
  batchQuantity Decimal  @default(100) @db.Decimal(12, 3)
  unitCost      Decimal? @db.Decimal(12, 4)
  notes         String   @default("")
  stirringRequirements  String @default("") @map("stirring_requirements")
  packagingRequirements String @default("") @map("packaging_requirements")
  productionNotes       String @default("") @map("production_notes")
  /// Cached: true when linked to a factory product directly or as a nested component recipe.
  formulaIsUsed         Boolean  @default(false) @map("formula_is_used")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category CosTableRecipeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  items    CosTableRecipeItem[]
  componentInItems CosTableRecipeItem[] @relation("RecipeItemComponent")
  productLinks CosTableProductRecipe[]
  currentForProducts CosTableFactoryProduct[] @relation("CurrentFactoryRecipe")
  productionOrders CosTableProductionOrder[]
  sourceColorFormulas CosTableColorFormula[]

  @@index([categoryId, name])
  @@map("cos_table_recipes")
}

model CosTableRecipeItem {
  id                     String   @id @default(cuid())
  recipeId               String
  rawMaterialId          String?
  componentRecipeId      String?
  productSemifinishedId  String?
  sortOrder              Int      @default(0)
  quantity               Decimal  @db.Decimal(12, 3)
  unitPrice              Decimal? @db.Decimal(12, 4)
  amount                 Decimal? @db.Decimal(14, 4)
  percentage             Decimal? @db.Decimal(8, 4)
  notes                  String   @default("")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  recipe              CosTableRecipe              @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  rawMaterial         CosTableRawMaterial?        @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  componentRecipe     CosTableRecipe?             @relation("RecipeItemComponent", fields: [componentRecipeId], references: [id], onDelete: Restrict)
  productSemifinished CosTableProductSemifinished? @relation(fields: [productSemifinishedId], references: [id], onDelete: Restrict)

  @@index([recipeId, sortOrder])
  @@index([componentRecipeId])
  @@index([productSemifinishedId])
  @@map("cos_table_recipe_items")
}

// ─────────────────────────────────────────────
// CosmoCoat — PRODUCT SEMIFINISHED (Sol. 半成品库存)
// ─────────────────────────────────────────────

model CosTableProductSemifinished {
  id                      String   @id @default(cuid())
  code                    String   @unique
  name                    String
  description             String   @default("")
  category                String   @default("Sol.")
  stock                   Decimal  @default(0) @db.Decimal(12, 3)
  unit                    String   @default("kg")
  unitPrice               Decimal? @db.Decimal(12, 4)
  sourceProductionOrderId String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  sourceProductionOrder CosTableProductionOrder? @relation(fields: [sourceProductionOrderId], references: [id], onDelete: SetNull)
  recipeItems           CosTableRecipeItem[]

  @@index([category])
  @@index([name])
  @@index([sourceProductionOrderId])
  @@map("cos_table_product_semifinished")
}

// ─────────────────────────────────────────────
// CosmoCoat — FACTORY PRODUCTS (工厂产品)
// ─────────────────────────────────────────────

model CosTableFactoryProduct {
  id              String   @id @default(cuid())
  productCode     String   @unique
  name            String
  categoryId      String?
  unit            String   @default("kg")
  unitPrice       Decimal? @db.Decimal(12, 4)
  notes           String   @default("")
  viscosity           Decimal? @db.Decimal(10, 3) @map("viscosity")
  viscosityUnit       String?  @map("viscosity_unit")
  currentRecipeId String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category      CosTableProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  currentRecipe CosTableRecipe? @relation("CurrentFactoryRecipe", fields: [currentRecipeId], references: [id], onDelete: SetNull)
  recipeLinks   CosTableProductRecipe[]
  productionOrders CosTableProductionOrder[]
  colorFormulas CosTableColorFormula[]

  @@index([name])
  @@index([sortOrder])
  @@index([categoryId])
  @@map("cos_table_factory_products")
}

model CosTableProductRecipe {
  id        String   @id @default(cuid())
  productId String
  recipeId  String
  createdAt DateTime @default(now())

  product CosTableFactoryProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  recipe  CosTableRecipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([productId, recipeId])
  @@index([recipeId])
  @@map("cos_table_product_recipes")
}

// ─────────────────────────────────────────────
// CosmoCoat — COLOR MATCHING FORMULAS (調色配方)
// ─────────────────────────────────────────────

enum CosColorFormulaCategory {
  PU
  BAKING_PAINT
  HT_BAKING_PAINT
  LT_BAKING_PAINT
}

/// @deprecated Legacy static subcategories — new formulas use factoryProductId on CosTableColorFormula.
model CosTableColorFormulaSubcategory {
  id             String                  @id @default(cuid())
  parentCategory CosColorFormulaCategory
  code           String
  name           String
  sortOrder      Int                     @default(0)
  isActive       Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  colorFormulas CosTableColorFormula[]

  @@unique([parentCategory, code])
  @@index([parentCategory, sortOrder])
  @@map("cos_table_color_formula_subcategories")
}

model CosTableColorFormula {
  id               String                  @id @default(cuid())
  code             String                  @unique
  name             String
  category         CosColorFormulaCategory
  /// @deprecated Legacy static subcategory — use factoryProductId for product-specific scope.
  subcategoryId    String?
  /// Specific factory product scope; null = applies to all products in category.
  factoryProductId String?
  sourceRecipeId   String?
  colorCode        String                  @default("")
  customerName     String                  @default("")
  targetColor      String                  @default("")
  batchQuantity    Decimal                 @default(100) @db.Decimal(12, 3)
  notes            String                  @default("")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  subcategory    CosTableColorFormulaSubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  factoryProduct CosTableFactoryProduct?        @relation(fields: [factoryProductId], references: [id], onDelete: SetNull)
  sourceRecipe   CosTableRecipe?                @relation(fields: [sourceRecipeId], references: [id], onDelete: SetNull)
  items          CosTableColorFormulaItem[]

  @@index([category, updatedAt])
  @@index([subcategoryId])
  @@index([factoryProductId])
  @@map("cos_table_color_formulas")
}

model CosTableColorFormulaItem {
  id            String   @id @default(cuid())
  formulaId     String
  rawMaterialId String
  sortOrder     Int      @default(0)
  quantity      Decimal  @db.Decimal(12, 3)
  unitPrice     Decimal? @db.Decimal(12, 4)
  amount        Decimal? @db.Decimal(14, 4)
  percentage    Decimal? @db.Decimal(8, 4)
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  formula     CosTableColorFormula @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  rawMaterial CosTableRawMaterial  @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  @@index([formulaId, sortOrder])
  @@index([rawMaterialId])
  @@map("cos_table_color_formula_items")
}

// ─────────────────────────────────────────────
// CosmoCoat — PRODUCTION ORDERS (生产单)
// ─────────────────────────────────────────────

model CosTableProductionOrder {
  id               String    @id @default(cuid())
  code             String    @unique
  factoryProductId String
  recipeId         String
  totalWeight      Decimal   @db.Decimal(12, 3)
  batchNo          String    @default("")
  startedAt        DateTime?
  finishedAt       DateTime?
  productionNotes  String    @default("")
  qualityNotes     String    @default("")
  packagingNotes   String    @default("")
  productionRequirements  String @default("") @map("production_requirements")
  qualityCheckRequirements String @default("") @map("quality_check_requirements")
  packagingRequirements   String @default("") @map("packaging_requirements")
  status           String    @default("draft")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  factoryProduct CosTableFactoryProduct @relation(fields: [factoryProductId], references: [id], onDelete: Restrict)
  recipe         CosTableRecipe         @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  items          CosTableProductionOrderItem[]
  semifinishedProducts CosTableProductSemifinished[]

  @@index([factoryProductId])
  @@index([createdAt])
  @@map("cos_table_production_orders")
}

model CosTableProductionOrderItem {
  id             String   @id @default(cuid())
  orderId        String
  rawMaterialId  String
  sortOrder      Int      @default(0)
  productionCode String
  materialName   String
  percentage     Decimal  @db.Decimal(8, 4)
  requiredWeight Decimal  @db.Decimal(12, 3)
  actualWeight   Decimal? @db.Decimal(12, 3)
  notes          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order       CosTableProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rawMaterial CosTableRawMaterial     @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  @@index([orderId, sortOrder])
  @@map("cos_table_production_order_items")
}

// ─────────────────────────────────────────────
// CosmoCoat — FINANCIAL MODULE (HKFRS Compliant)
// ─────────────────────────────────────────────

enum AccountType {
  ASSET            // 资产
  LIABILITY        // 负债
  EQUITY           // 权益
  REVENUE          // 收入
  EXPENSE          // 费用
  CGS              // 销售成本 Cost of Goods Sold
  CURRENT_ACCOUNT  // 往来账 C/A Account (customer/supplier)
}

enum JournalStatus {
  DRAFT    // 草稿
  POSTED   // 已过账
  CANCELLED // 已取消
}

model CosTableAccount {
  id            String      @id @default(cuid())
  code          String      @unique // 科目编号：1001, 2001 等
  name          String      // 科目名称
  type          AccountType
  parentId      String?     // 父科目（支持层级结构）
  level         Int         @default(1) // 层级深度
  sortOrder     Int         @default(0)
  isSystem      Boolean     @default(false) // 系统科目锁定
  notes         String      @default("")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  parent        CosTableAccount?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children      CosTableAccount[]     @relation("AccountHierarchy")
  journalLines  CosTableJournalLine[]
  ledgerEntries CosTableLedger[]
  accountBalls  CosTableAccountBalance[]

  @@index([type, sortOrder])
  @@map("cos_accounts")
}

model CosTableJournalEntry {
  id            String      @id @default(cuid())
  voucherNo     String      @unique // 凭证号
  entryDate     DateTime    // 入账日期
  description   String      // 摘要
  period        String      // YYYY-MM 会计期间
  status        JournalStatus @default(DRAFT)
  attachments   String[]    // 附件 URL 数组
  createdById   String?
  postedAt      DateTime?
  reversedAt    DateTime?

  createdBy     User?           @relation(fields: [createdById], references: [id])
  lines         CosTableJournalLine[]
  ledgerEntries CosTableLedger[]

  @@index([period, status])
  @@index([entryDate])
  @@map("cos_journal_entries")
}

model CosTableJournalLine {
  id          String   @id @default(cuid())
  entryId     String
  accountId   String
  lineNum     Int      @default(0) // 显示顺序
  description String   // 行描述
  debit       Decimal  @default(0.0) @db.Decimal(18, 4)
  credit      Decimal  @default(0.0) @db.Decimal(18, 4)
  notes       String   @default("")

  entry         CosTableJournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account       CosTableAccount      @relation(fields: [accountId], references: [id])

  @@index([entryId, lineNum])
  @@index([accountId])
  @@map("cos_journal_lines")
}

model CosTableLedger {
  id          String   @id @default(cuid())
  accountId   String
  entryId     String?  // 过账时关联 EntryID
  date        DateTime
  voucherNo   String?  // 凭证号引用
  description String
  debit       Decimal  @default(0.0) @db.Decimal(18, 4)
  credit      Decimal  @default(0.0) @db.Decimal(18, 4)
  balance     Decimal  @default(0.0) @db.Decimal(18, 4) // 累计余额

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account     CosTableAccount        @relation(fields: [accountId], references: [id])
  entry       CosTableJournalEntry?  @relation(fields: [entryId], references: [id])

  @@index([accountId, date])
  @@index([date])
  @@index([voucherNo])
  @@map("cos_ledger")
}

model CosTableAccountBalance {
  id            String   @id @default(cuid())
  accountId     String
  period        String   // YYYY-MM
  openingDebit  Decimal  @default(0.0) @db.Decimal(18, 4)
  openingCredit Decimal  @default(0.0) @db.Decimal(18, 4)
  closingDebit  Decimal  @default(0.0) @db.Decimal(18, 4)
  closingCredit Decimal  @default(0.0) @db.Decimal(18, 4)
  endingBalance Decimal  @default(0.0) @db.Decimal(18, 4) // 期末余额（带符号）

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  account       CosTableAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId, period])
  @@index([period])
  @@map("cos_account_balances")
}

model CosTableExchangeRate {
  id            String   @id @default(cuid())
  fromCurrency  String   // HKD, USD, RMB
  toCurrency    String
  rate          Decimal  @db.Decimal(10, 6)
  effectiveDate DateTime
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([fromCurrency, toCurrency, effectiveDate])
  @@index([fromCurrency, toCurrency])
  @@map("cos_exchange_rates")
}

// ─────────────────────────────────────────────
// CosmoCoat — Process Kits (產品配套工藝書)
// ─────────────────────────────────────────────

/// Process Kit - 产品配套工艺书（组合多个产品 + 使用方法）
model CosProcessKit {
  id            String           @id @default(cuid())
  code          String           @unique
  name          String
  description   String?
  materials     String[]
  otherNote     String?
  status        ProcessKitStatus @default(DRAFT)
  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  createdByUser User? @relation("ProcessKitCreator", fields: [createdBy], references: [id])
  updatedByUser User? @relation("ProcessKitUpdater", fields: [updatedBy], references: [id])

  products CosProcessKitProduct[]
  tests    CosProcessTest[]

  @@index([status])
  @@map("cos_process_kits")
}

/// Product in a Process Kit - 工艺书中的产品组合
model CosProcessKitProduct {
  id            String  @id @default(cuid())
  kitId         String
  productId     String
  productName   String
  sortOrder     Int     @default(0)
  quantityRatio String?
  usageMethod   String
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kit CosProcessKit @relation(fields: [kitId], references: [id], onDelete: Cascade)

  @@index([kitId])
  @@index([productId])
  @@map("cos_process_kit_products")
}

/// Test Records for Process Kit - 工艺书的测试记录
model CosProcessTest {
  id         String            @id @default(cuid())
  kitId      String
  testType   ProcessTestType
  testResult ProcessTestResult @default(PENDING)
  testDate   DateTime
  testerName String
  testerId   String?
  reportLink String?
  testNotes  String?
  passedAt   DateTime?

  kit          CosProcessKit @relation(fields: [kitId], references: [id], onDelete: Cascade)
  testedByUser User?         @relation("ProcessTestTester", fields: [testerId], references: [id])

  @@index([kitId])
  @@index([testType])
  @@index([testResult])
  @@index([testDate])
  @@map("cos_process_tests")
}

// ─────────────────────────────────────────────
// Adviser — FINANCIAL ACCOUNTING MODULE
// ─────────────────────────────────────────────

model FinAccount {
  id            String      @id @default(cuid())
  code          String
  name          String
  type          AccountType
  parentId      String?
  companyId     String?
  level         Int         @default(1)
  sortOrder     Int         @default(0)
  isSystem      Boolean     @default(false)
  notes         String      @default("")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  parent        FinAccount?      @relation("FinAccountHierarchy", fields: [parentId], references: [id])
  children      FinAccount[]     @relation("FinAccountHierarchy")
  company       Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  journalLines  JournalLine[]
  ledgerEntries Ledger[]
  accountBalances AccountBalance[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([type, sortOrder])
  @@map("adv_accounts")
}

model JournalEntry {
  id            String        @id @default(cuid())
  voucherNo     String        @unique
  entryDate     DateTime
  description   String
  period        String
  status        JournalStatus @default(DRAFT)
  attachments   String[]      @default([])
  companyId     String?
  createdById   String?
  postedAt      DateTime?
  reversedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company       Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy     User?              @relation("FinancialJournalCreatedBy", fields: [createdById], references: [id])
  lines         JournalLine[]
  ledgerEntries Ledger[]

  @@index([period, status])
  @@index([entryDate])
  @@index([companyId])
  @@map("adv_journal_entries")
}

model JournalLine {
  id          String   @id @default(cuid())
  entryId     String
  accountId   String
  lineNum     Int      @default(0)
  description String
  debit       Decimal  @default(0.0) @db.Decimal(18, 4)
  credit      Decimal  @default(0.0) @db.Decimal(18, 4)
  notes       String   @default("")

  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account     FinAccount   @relation(fields: [accountId], references: [id])

  @@index([entryId, lineNum])
  @@index([accountId])
  @@map("adv_journal_lines")
}

model Ledger {
  id          String   @id @default(cuid())
  accountId   String
  entryId     String?
  companyId   String?
  lineNum     Int      @default(0)
  date        DateTime
  voucherNo   String
  description String
  debit       Decimal  @default(0.0) @db.Decimal(18, 4)
  credit      Decimal  @default(0.0) @db.Decimal(18, 4)
  balance     Decimal  @default(0.0) @db.Decimal(18, 4)

  account     FinAccount    @relation(fields: [accountId], references: [id])
  entry       JournalEntry? @relation(fields: [entryId], references: [id])
  company     Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([accountId, date, lineNum])
  @@index([companyId, accountId, date, lineNum])
  @@index([date])
  @@index([voucherNo])
  @@map("adv_ledger")
}

model AccountBalance {
  id            String   @id @default(cuid())
  accountId     String
  period        String
  openingDebit  Decimal  @default(0.0) @db.Decimal(18, 4)
  openingCredit Decimal  @default(0.0) @db.Decimal(18, 4)
  closingDebit  Decimal  @default(0.0) @db.Decimal(18, 4)
  closingCredit Decimal  @default(0.0) @db.Decimal(18, 4)
  endingBalance Decimal  @default(0.0) @db.Decimal(18, 4)

  account       FinAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId, period])
  @@index([period])
  @@map("adv_account_balances")
}

model ExchangeRate {
  id            String   @id @default(cuid())
  fromCurrency  String
  toCurrency    String
  rate          Decimal  @db.Decimal(10, 6)
  effectiveDate DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([fromCurrency, toCurrency, effectiveDate])
  @@index([fromCurrency, toCurrency])
  @@map("adv_exchange_rates")
}
