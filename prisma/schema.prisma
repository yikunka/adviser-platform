  unitPrice   Decimal  @db.Decimal(18, 2)
  amount      Decimal  @db.Decimal(18, 2)

  invoice SfsInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, sortOrder])
  @@map("sfs_invoice_line_items")
}

// ─────────────────────────────────────────────
// SHARED FINANCIAL ENUMS (Adviser accounting)
// ─────────────────────────────────────────────

enum AccountType {
  ASSET // 流动资产
  NON_CURRENT_ASSET // 长期资产
  LIABILITY // 流动负债
  NON_CURRENT_LIABILITY // 长期负债
  EQUITY // 权益
  REVENUE // 收入
  EXPENSE // 费用
  CGS // 销售成本 Cost of Goods Sold
  CURRENT_ACCOUNT // 往来账 C/A Account (customer/supplier)
}

enum JournalStatus {
  DRAFT // 草稿
  POSTED // 已过账
  CANCELLED // 已取消
}

enum JournalSourceType {
  MANUAL // 手工凭证
  SALES_INVOICE // 销售发票 (AR)
  RECEIPT // 收款 (AR)
  CREDIT_NOTE // 贷项/借项通知单
  PURCHASE_BILL // 采购账单 (AP)
  BILL_PAYMENT // 付款 (AP)
  BANK // 银行调整
  DEPRECIATION // 折旧 (预留)
  CLOSING // 期末结转 (预留)
  RECURRING // 周期凭证 (预留)
}

enum FiscalPeriodStatus {
  OPEN // 开放
  CLOSED // 已关账（可重开）
  LOCKED // 已锁定（不可重开）
}

enum AccountMappingKey {
  AR_CONTROL // 应收账款控制科目
  AP_CONTROL // 应付账款控制科目
  SALES_REVENUE // 默认销售收入
  OUTPUT_TAX // 销项税
  INPUT_TAX // 进项税
  BANK_DEFAULT // 默认银行存款
  CASH_DEFAULT // 默认现金
  PURCHASE_EXPENSE_DEFAULT // 默认采购费用
  BANK_FEES // 银行手续费
  EXCHANGE_GAIN_LOSS // 汇兑损益 (预留)
  RETAINED_EARNINGS // 留存收益 (预留, 年结)
}

enum SalesInvoiceStatus {
  DRAFT // 草稿
  ISSUED // 已开票（已过账）
  PARTIALLY_PAID // 部分收款
  PAID // 已收款
  VOIDED // 已作废
}

enum PurchaseBillStatus {
  DRAFT // 草稿
  POSTED // 已入账
  PARTIALLY_PAID // 部分付款
  PAID // 已付款
  VOIDED // 已作废
}

enum CreditNoteKind {
  CUSTOMER // 贷项通知单（冲减应收）
  SUPPLIER // 借项通知单（冲减应付）
}

enum CreditNoteStatus {
  DRAFT // 草稿
  POSTED // 已入账
  VOIDED // 已作废
}

enum FinPaymentDirection {
  RECEIPT // 收款（客户）
  PAYMENT // 付款（供应商）
}

enum FinPaymentStatus {
  POSTED // 已入账
  VOIDED // 已作废
}

enum FinPaymentMethod {
  BANK_TRANSFER // 银行转账
  CASH // 现金
  CHEQUE // 支票
  CARD // 银行卡
  OTHER // 其他
}

enum BankStatementLineStatus {
  UNMATCHED // 未匹配
  MATCHED // 已匹配
  EXCLUDED // 已排除
}

enum BankReconciliationStatus {
  IN_PROGRESS // 进行中
  COMPLETED // 已完成
}

// ─────────────────────────────────────────────
// Adviser — FINANCIAL ACCOUNTING MODULE
// ─────────────────────────────────────────────

model FinAccount {
  id               String      @id @default(cuid())
  code             String
  name             String
  type             AccountType
  parentId         String?
  companyId        String?
  level            Int         @default(1)
  sortOrder        Int         @default(0)
  isSystem         Boolean     @default(false)
  notes            String      @default("")
  yearToDateAmount Decimal     @default(0.0) @db.Decimal(18, 4)
  yearToDateDebit  Decimal     @default(0.0) @db.Decimal(18, 4)
  yearToDateCredit Decimal     @default(0.0) @db.Decimal(18, 4)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  parent          FinAccount?      @relation("FinAccountHierarchy", fields: [parentId], references: [id])
  children        FinAccount[]     @relation("FinAccountHierarchy")
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  journalLines    JournalLine[]
  ledgerEntries   Ledger[]
  accountBalances AccountBalance[]

  partyArOverrides  Party[]            @relation("PartyArAccount")
  partyApOverrides  Party[]            @relation("PartyApAccount")
  accountMappings   AccountMapping[]   @relation("AccountMappingAccount")
  reportSectionMappings FinancialReportSectionMapping[] @relation("ReportSectionMappingAccount")
  salesInvoiceLines SalesInvoiceLine[] @relation("SalesLineRevenueAccount")
  purchaseBillLines PurchaseBillLine[] @relation("PurchaseLineExpenseAccount")
  creditNoteOffsets FinCreditNote[]    @relation("CreditNoteOffsetAccount")
  bankAccounts      BankAccount[]      @relation("BankGlAccount")

  @@unique([companyId, code])
  @@index([companyId])
  @@index([type, sortOrder])
  @@map("adv_accounts")
}

model JournalEntry {
  id           String            @id @default(cuid())
  voucherNo    String            @unique
  entryDate    DateTime
  description  String
  period       String
  status       JournalStatus     @default(DRAFT)
  attachments  String[]          @default([])
  companyId    String?
  createdById  String?
  /// 源单据类型：MANUAL=手工，其余为子分类账自动过账
  sourceType   JournalSourceType @default(MANUAL)
  /// 源单据 ID（与 sourceType 配合定位发票/收款/账单等）
  sourceId     String?
  /// 红冲链：本凭证是哪张凭证的反向凭证
  reversalOfId String?           @unique
  postedAt     DateTime?
  reversedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  company       Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy     User?         @relation("FinancialJournalCreatedBy", fields: [createdById], references: [id])
  reversalOf    JournalEntry? @relation("JournalReversalChain", fields: [reversalOfId], references: [id])
  reversedBy    JournalEntry? @relation("JournalReversalChain")
  lines         JournalLine[]
  ledgerEntries Ledger[]

  salesInvoice  SalesInvoice?  @relation("SalesInvoiceJournal")
  purchaseBill  PurchaseBill?  @relation("PurchaseBillJournal")
  finPayment    FinPayment?    @relation("FinPaymentJournal")
  finCreditNote FinCreditNote? @relation("FinCreditNoteJournal")

  @@index([period, status])
  @@index([entryDate])
  @@index([companyId])
  @@index([sourceType, sourceId])
  @@map("adv_journal_entries")
}

model JournalLine {
  id          String  @id @default(cuid())
  entryId     String
  accountId   String
  lineNum     Int     @default(0)
  description String
  debit       Decimal @default(0.0) @db.Decimal(18, 4)
  credit      Decimal @default(0.0) @db.Decimal(18, 4)
  notes       String  @default("")

  // ── 扩展预留字段（可空）──
  partyId String? // 往来单位（客户/供应商/员工）

  // ── 多币种（预留，可空；null = 本位币交易）──
  currency     String? // 原币币种，null = 本位币
  origDebit    Decimal? @db.Decimal(18, 4) // 原币借方
  origCredit   Decimal? @db.Decimal(18, 4) // 原币贷方
  exchangeRate Decimal? @db.Decimal(12, 6) // 交易汇率（原币→本位币）

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account FinAccount   @relation(fields: [accountId], references: [id])
  party   Party?       @relation(fields: [partyId], references: [id], onDelete: SetNull)

  @@index([entryId, lineNum])
  @@index([accountId])
  @@index([partyId])
  @@map("adv_journal_lines")
}

model Ledger {
  id          String   @id @default(cuid())
  accountId   String
  entryId     String?
  companyId   String?
  lineNum     Int      @default(0)
  date        DateTime
  voucherNo   String
  description String
  debit       Decimal  @default(0.0) @db.Decimal(18, 4)
  credit      Decimal  @default(0.0) @db.Decimal(18, 4)
  balance     Decimal  @default(0.0) @db.Decimal(18, 4)

  account              FinAccount          @relation(fields: [accountId], references: [id])
  entry                JournalEntry?       @relation(fields: [entryId], references: [id])
  company              Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  bankStatementMatches BankStatementLine[] @relation("StatementLineLedger")

  @@index([accountId, date, lineNum])
  @@index([companyId, accountId, date, lineNum])
  @@index([date])
  @@index([voucherNo])
  @@map("adv_ledger")
}

model AccountBalance {
  id            String  @id @default(cuid())
  accountId     String
  period        String
  openingDebit  Decimal @default(0.0) @db.Decimal(18, 4)
  openingCredit Decimal @default(0.0) @db.Decimal(18, 4)
  closingDebit  Decimal @default(0.0) @db.Decimal(18, 4)
  closingCredit Decimal @default(0.0) @db.Decimal(18, 4)
  endingBalance Decimal @default(0.0) @db.Decimal(18, 4)

  account FinAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId, period])
  @@index([period])
  @@map("adv_account_balances")
}

model FinancialHistoryLedgerBook {
  id           String   @id @default(cuid())
  companyId    String
  title        String
  fileName     String
  fileKey      String
  fileUrl      String
  mimeType     String
  fileSize     Int
  sheets       Json
  notes        String   @default("")
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("FinancialHistoryLedgerBookUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([uploadedById])
  @@map("adv_financial_history_ledger_books")
}

model ExchangeRate {
  id            String   @id @default(cuid())
  fromCurrency  String
  toCurrency    String
  rate          Decimal  @db.Decimal(10, 6)
  effectiveDate DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([fromCurrency, toCurrency, effectiveDate])
  @@index([fromCurrency, toCurrency])
  @@map("adv_exchange_rates")
}

// ─────────────────────────────────────────────
// FINANCIAL SUBLEDGERS — Phase 0 骨架 + AR / AP / BANKING
// 总账 (JournalEntry/Ledger) 是唯一事实来源；
// 以下子分类账单据通过统一过账引擎生成凭证。
// ─────────────────────────────────────────────

/// 统一往来单位：客户 / 供应商 / 员工共用一张主表（角色用布尔标志区分）
model Party {
  id               String   @id @default(cuid())
  companyId        String
  code             String // CL-0001 / SP-0001 / ST-0001
  name             String
  nameZh           String?
  isCustomer       Boolean  @default(false)
  isSupplier       Boolean  @default(false)
  isEmployee       Boolean  @default(false)
  email            String?
  phone            String?
  address          String?
  taxNumber        String?
  currency         String   @default("HKD")
  paymentTermsDays Int      @default(30)
  creditLimit      Decimal? @db.Decimal(18, 2)
  arAccountId      String? // 覆盖默认应收控制科目
  apAccountId      String? // 覆盖默认应付控制科目
  notes            String   @default("")
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  arAccount     FinAccount?     @relation("PartyArAccount", fields: [arAccountId], references: [id])
  apAccount     FinAccount?     @relation("PartyApAccount", fields: [apAccountId], references: [id])
  journalLines  JournalLine[]
  salesInvoices SalesInvoice[]
  purchaseBills PurchaseBill[]
  payments      FinPayment[]
  creditNotes   FinCreditNote[]

  @@unique([companyId, code])
  @@index([companyId, isCustomer, isActive])
  @@index([companyId, isSupplier, isActive])
  @@index([name])
  @@map("adv_parties")
}

/// 会计期间锁：无记录 = OPEN；过账前校验
model FiscalPeriod {
  id         String             @id @default(cuid())
  companyId  String
  period     String // YYYY-MM
  status     FiscalPeriodStatus @default(OPEN)
  closedAt   DateTime?
  closedById String?

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  closedBy User?   @relation("FiscalPeriodClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  @@unique([companyId, period])
  @@index([companyId, status])
  @@map("adv_fiscal_periods")
}

/// 过账科目映射：子分类账自动凭证使用哪些科目（无配置时按默认科目代码回退）
model AccountMapping {
  id        String            @id @default(cuid())
  companyId String
  key       AccountMappingKey
  accountId String

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account FinAccount @relation("AccountMappingAccount", fields: [accountId], references: [id])

  @@unique([companyId, key])
  @@map("adv_account_mappings")
}

/// 财务报表结构映射：利润表 / 资产负债表各分类由哪些科目构成（按公司配置）
enum FinancialReportSection {
  PL_REVENUE
  PL_COST_OF_SALES
  PL_EXPENSE_SALES
  PL_EXPENSE_ADMINISTRATIVE
  PL_EXPENSE_FINANCE
  BS_CURRENT_ASSETS
  BS_NON_CURRENT_ASSETS
  BS_CURRENT_LIABILITIES
  BS_NON_CURRENT_LIABILITIES
  BS_EQUITY
}

model FinancialReportSectionMapping {
  id        String                 @id @default(cuid())
  companyId String
  section   FinancialReportSection
  accountId String
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account FinAccount @relation("ReportSectionMappingAccount", fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([companyId, section, accountId])
  @@index([companyId, section])
  @@index([accountId])
  @@map("adv_financial_report_section_mappings")
}

/// 单号序列：并发安全的单据编号（事务内 upsert + increment）
model DocSequence {
  id         String @id @default(cuid())
  companyId  String
  docType    String // SALES_INVOICE / RECEIPT / CREDIT_NOTE / PURCHASE_BILL / BILL_PAYMENT ...
  periodKey  String // YYYYMM
  lastNumber Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, docType, periodKey])
  @@map("adv_doc_sequences")
}

/// 销售发票（AR 子分类账；companyId = 账套所属公司，partyId = 该公司的客户）
model SalesInvoice {
  id             String             @id @default(cuid())
  companyId      String
  partyId        String
  invoiceNo      String
  status         SalesInvoiceStatus @default(DRAFT)
  issueDate      DateTime
  dueDate        DateTime?
  currency       String             @default("HKD")
  subtotal       Decimal            @db.Decimal(18, 2)
  taxRate        Decimal            @default(0) @db.Decimal(5, 4)
  taxAmount      Decimal            @default(0) @db.Decimal(18, 2)
  total          Decimal            @db.Decimal(18, 2)
  amountPaid     Decimal            @default(0) @db.Decimal(18, 2)
  notes          String             @default("")
  journalEntryId String?            @unique
  createdById    String?
  postedAt       DateTime?
  voidedAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party        Party               @relation(fields: [partyId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry?       @relation("SalesInvoiceJournal", fields: [journalEntryId], references: [id])
  createdBy    User?               @relation("SalesInvoiceCreatedBy", fields: [createdById], references: [id])
  lines        SalesInvoiceLine[]
  allocations  PaymentAllocation[]

  @@unique([companyId, invoiceNo])
  @@index([companyId, status, dueDate])
  @@index([partyId, status])
  @@index([issueDate])
  @@map("adv_sales_invoices")
}

model SalesInvoiceLine {
  id               String  @id @default(cuid())
  invoiceId        String
  sortOrder        Int     @default(0)
  description      String
  quantity         Decimal @default(1) @db.Decimal(12, 4)
  unitPrice        Decimal @db.Decimal(18, 2)
  amount           Decimal @db.Decimal(18, 2)
  revenueAccountId String? // 行级收入科目；null = 用映射默认

  invoice        SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  revenueAccount FinAccount?  @relation("SalesLineRevenueAccount", fields: [revenueAccountId], references: [id])

  @@index([invoiceId, sortOrder])
  @@map("adv_sales_invoice_lines")
}

/// 采购账单（AP 子分类账）
model PurchaseBill {
  id             String             @id @default(cuid())
  companyId      String
  partyId        String
  billNo         String // 内部编号 BILL-YYYYMM-####
  supplierRef    String             @default("") // 供应商发票号
  status         PurchaseBillStatus @default(DRAFT)
  billDate       DateTime
  dueDate        DateTime?
  currency       String             @default("HKD")
  subtotal       Decimal            @db.Decimal(18, 2)
  taxRate        Decimal            @default(0) @db.Decimal(5, 4)
  taxAmount      Decimal            @default(0) @db.Decimal(18, 2)
  total          Decimal            @db.Decimal(18, 2)
  amountPaid     Decimal            @default(0) @db.Decimal(18, 2)
  notes          String             @default("")
  journalEntryId String?            @unique
  createdById    String?
  postedAt       DateTime?
  voidedAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party        Party               @relation(fields: [partyId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry?       @relation("PurchaseBillJournal", fields: [journalEntryId], references: [id])
  createdBy    User?               @relation("PurchaseBillCreatedBy", fields: [createdById], references: [id])
  lines        PurchaseBillLine[]
  allocations  PaymentAllocation[]

  @@unique([companyId, billNo])
  @@index([companyId, status, dueDate])
  @@index([partyId, status])
  @@index([billDate])
  @@map("adv_purchase_bills")
}

model PurchaseBillLine {
  id               String  @id @default(cuid())
  billId           String
  sortOrder        Int     @default(0)
  description      String
  quantity         Decimal @default(1) @db.Decimal(12, 4)
  unitPrice        Decimal @db.Decimal(18, 2)
  amount           Decimal @db.Decimal(18, 2)
  expenseAccountId String? // 行级费用/资产科目；null = 用映射默认

  bill           PurchaseBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  expenseAccount FinAccount?  @relation("PurchaseLineExpenseAccount", fields: [expenseAccountId], references: [id])

  @@index([billId, sortOrder])
  @@map("adv_purchase_bill_lines")
}

/// 收付款（RECEIPT=客户收款，PAYMENT=供应商付款；创建即过账）
model FinPayment {
  id              String              @id @default(cuid())
  companyId       String
  partyId         String
  direction       FinPaymentDirection
  paymentNo       String // RCT-YYYYMM-#### / PAY-YYYYMM-####
  status          FinPaymentStatus    @default(POSTED)
  paymentDate     DateTime
  method          FinPaymentMethod    @default(BANK_TRANSFER)
  bankAccountId   String? // 收/付款银行账户；null = 现金（按映射）
  currency        String              @default("HKD")
  amount          Decimal             @db.Decimal(18, 2)
  amountAllocated Decimal             @default(0) @db.Decimal(18, 2)
  reference       String              @default("")
  notes           String              @default("")
  journalEntryId  String?             @unique
  createdById     String?
  voidedAt        DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party        Party               @relation(fields: [partyId], references: [id], onDelete: Restrict)
  bankAccount  BankAccount?        @relation(fields: [bankAccountId], references: [id])
  journalEntry JournalEntry?       @relation("FinPaymentJournal", fields: [journalEntryId], references: [id])
  createdBy    User?               @relation("FinPaymentCreatedBy", fields: [createdById], references: [id])
  allocations  PaymentAllocation[]

  @@unique([companyId, paymentNo])
  @@index([companyId, direction, paymentDate])
  @@index([partyId])
  @@map("adv_fin_payments")
}

/// 核销：收/付款或贷项/借项 ↔ 发票/账单 的金额分配
model PaymentAllocation {
  id             String   @id @default(cuid())
  paymentId      String?
  creditNoteId   String?
  salesInvoiceId String?
  purchaseBillId String?
  amount         Decimal  @db.Decimal(18, 2)
  createdAt      DateTime @default(now())

  payment      FinPayment?    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  creditNote   FinCreditNote? @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  salesInvoice SalesInvoice?  @relation(fields: [salesInvoiceId], references: [id])
  purchaseBill PurchaseBill?  @relation(fields: [purchaseBillId], references: [id])

  @@index([paymentId])
  @@index([creditNoteId])
  @@index([salesInvoiceId])
  @@index([purchaseBillId])
  @@map("adv_payment_allocations")
}

/// 贷项通知单（CUSTOMER 冲减应收）/ 借项通知单（SUPPLIER 冲减应付）
model FinCreditNote {
  id              String           @id @default(cuid())
  companyId       String
  partyId         String
  kind            CreditNoteKind
  noteNo          String // CN-YYYYMM-#### / DN-YYYYMM-####
  status          CreditNoteStatus @default(DRAFT)
  issueDate       DateTime
  currency        String           @default("HKD")
  subtotal        Decimal          @db.Decimal(18, 2)
  taxRate         Decimal          @default(0) @db.Decimal(5, 4)
  taxAmount       Decimal          @default(0) @db.Decimal(18, 2)
  total           Decimal          @db.Decimal(18, 2)
  amountApplied   Decimal          @default(0) @db.Decimal(18, 2)
  reason          String           @default("")
  offsetAccountId String? // 冲减对方科目（收入/费用）；null = 用映射默认
  journalEntryId  String?          @unique
  createdById     String?
  postedAt        DateTime?
  voidedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party         Party               @relation(fields: [partyId], references: [id], onDelete: Restrict)
  offsetAccount FinAccount?         @relation("CreditNoteOffsetAccount", fields: [offsetAccountId], references: [id])
  journalEntry  JournalEntry?       @relation("FinCreditNoteJournal", fields: [journalEntryId], references: [id])
  createdBy     User?               @relation("FinCreditNoteCreatedBy", fields: [createdById], references: [id])
  allocations   PaymentAllocation[]

  @@unique([companyId, noteNo])
  @@index([companyId, kind, status])
  @@index([partyId])
  @@map("adv_fin_credit_notes")
}

/// 银行账户（关联一个总账科目）
model BankAccount {
  id            String   @id @default(cuid())
  companyId     String
  glAccountId   String
  name          String
  bankName      String   @default("")
  accountNumber String   @default("")
  currency      String   @default("HKD")
  isActive      Boolean  @default(true)
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  glAccount       FinAccount           @relation("BankGlAccount", fields: [glAccountId], references: [id])
  payments        FinPayment[]
  statements      BankStatement[]
  reconciliations BankReconciliation[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("adv_bank_accounts")
}

/// 银行对账单（一次导入）
model BankStatement {
  id             String    @id @default(cuid())
  bankAccountId  String
  fileName       String    @default("")
  periodStart    DateTime?
  periodEnd      DateTime?
  openingBalance Decimal?  @db.Decimal(18, 2)
  closingBalance Decimal?  @db.Decimal(18, 2)
  importedById   String?
  createdAt      DateTime  @default(now())

  bankAccount BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  importedBy  User?               @relation("BankStatementImportedBy", fields: [importedById], references: [id])
  lines       BankStatementLine[]

  @@index([bankAccountId])
  @@map("adv_bank_statements")
}

model BankStatementLine {
  id               String                  @id @default(cuid())
  statementId      String
  lineNum          Int                     @default(0)
  date             DateTime
  description      String                  @default("")
  reference        String                  @default("")
  amount           Decimal                 @db.Decimal(18, 2) // 有符号：+流入 -流出
  status           BankStatementLineStatus @default(UNMATCHED)
  matchedLedgerId  String?
  reconciliationId String?

  statement      BankStatement       @relation(fields: [statementId], references: [id], onDelete: Cascade)
  matchedLedger  Ledger?             @relation("StatementLineLedger", fields: [matchedLedgerId], references: [id], onDelete: SetNull)
  reconciliation BankReconciliation? @relation(fields: [reconciliationId], references: [id], onDelete: SetNull)

  @@index([statementId, lineNum])
  @@index([status])
  @@index([matchedLedgerId])
  @@map("adv_bank_statement_lines")
}

/// 银行对账（一次对账过程：截止日 + 对账单余额 vs 总账余额）
model BankReconciliation {
  id               String                   @id @default(cuid())
  bankAccountId    String
  statementDate    DateTime // 对账截止日
  statementBalance Decimal                  @db.Decimal(18, 2)
  glBalance        Decimal                  @db.Decimal(18, 2)
  status           BankReconciliationStatus @default(IN_PROGRESS)
  notes            String                   @default("")
  createdById      String?
  completedAt      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  bankAccount    BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  createdBy      User?               @relation("BankReconCreatedBy", fields: [createdById], references: [id])
  statementLines BankStatementLine[]

  @@index([bankAccountId, status])
  @@map("adv_bank_reconciliations")
}

// ─────────────────────────────────────────────
// FEEDBACK / REQUIREMENTS PLUGIN
// ─────────────────────────────────────────────

enum FeatureRequestStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  DONE
  REJECTED
}

model FeedbackConfig {
  id             String   @id @default("singleton") // always one row
  provider       String   @default("anthropic") // anthropic | deepseek | alibaba
  model          String   @default("claude-opus-4-5")
  // API keys stored in DB (overrides env vars when set)
  anthropicKey   String   @default("")
  deepseekKey    String   @default("")
  alibabaKey     String   @default("")
  // Dev-tool access: SHA-256 hash of the generated bearer token
  devtoolKeyHash String   @default("")
  updatedAt      DateTime @updatedAt

  @@map("adv_feedback_config")
}

model FeatureRequest {
  id           String               @id @default(cuid())
  number       Int                  @default(autoincrement())
  pageUrl      String // page where the request was submitted
  pageTitle    String               @default("")
  title        String               @default("") // LLM-confirmed title
  summary      String // LLM-confirmed requirement summary
  priority     String               @default("medium") // low | medium | high
  conversation Json // full chat history for reference
  attachments  Json                 @default("[]") // [{url, name, type}]
  status       FeatureRequestStatus @default(PENDING)
  userId       String?
  userEmail    String?
  userName     String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  user User? @relation("FeatureRequestSubmitter", fields: [userId], references: [id])

  @@index([status, createdAt])
  @@index([userId])
  @@map("adv_feature_requests")
}

// ─────────────────────────────────────────────
// JMM TRADING — offline order desk (staff only)
// ─────────────────────────────────────────────

model JmmCustomer {
  id              String   @id @default(cuid())
  name            String
  company         String   @default("")
  phone           String   @default("")
  email           String   @default("")
  address         String   @default("")
  deliveryAddress String   @default("")
  vatNumber       String   @default("")
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders JmmOrder[]

  @@index([name])
  @@index([company])
  @@index([vatNumber])
  @@map("jmm_customers")
}

model JmmOrder {
  id          String         @id @default(cuid())
  orderNumber String         @unique
  customerId  String
  orderDate   DateTime       @default(now())
  status      JmmOrderStatus @default(DRAFT)
  currency    String         @default("USD")
  notes       String         @default("")
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  customer  JmmCustomer      @relation(fields: [customerId], references: [id])
  createdBy User?            @relation("JmmOrderCreatedBy", fields: [createdById], references: [id])
  lines     JmmOrderLine[]
  documents JmmDocument[]
  supplierInvoices JmmSupplierInvoice[]

  @@index([customerId])
  @@index([status])
  @@index([orderDate])
  @@map("jmm_orders")
}

model JmmOrderLine {
  id          String  @id @default(cuid())
  orderId     String
  sortOrder   Int     @default(0)
  description String
  quantity    Decimal @db.Decimal(18, 3)
  unit        String  @default("")
  unitPrice   Decimal @db.Decimal(18, 2)
  amount      Decimal @db.Decimal(18, 2)

  order JmmOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("jmm_order_lines")
}

model JmmDocument {
  id               String             @id @default(cuid())
  orderId          String
  kind             JmmDocumentKind
  status           JmmDocumentStatus  @default(DRAFT)
  documentNumber   String             @unique
  sourceDocumentId String?
  documentDate     DateTime           @default(now())
  currency         String
  customerName     String
  company          String             @default("")
  vatNumber        String             @default("")
  deliveryAddress  String             @default("")
  notes            String             @default("")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  order   JmmOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  source  JmmDocument?      @relation("JmmDocumentChain", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  derived JmmDocument[]     @relation("JmmDocumentChain")
  lines   JmmDocumentLine[]

  @@index([orderId, kind, status])
  @@index([sourceDocumentId])
  @@map("jmm_documents")
}

model JmmDocumentLine {
  id          String  @id @default(cuid())
  documentId  String
  sortOrder   Int     @default(0)
  description String
  quantity    Decimal @db.Decimal(18, 3)
  unit        String  @default("")
  unitPrice   Decimal @db.Decimal(18, 2)
  amount      Decimal @db.Decimal(18, 2)

  document JmmDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("jmm_document_lines")
}

model JmmSupplier {
  id        String   @id @default(cuid())
  name      String
  company   String   @default("")
  phone     String   @default("")
  email     String   @default("")
  address   String   @default("")
  vatNumber String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices JmmSupplierInvoice[]

  @@index([name])
  @@index([company])
  @@map("jmm_suppliers")
}

model JmmSupplierInvoice {
  id            String                   @id @default(cuid())
  orderId       String
  supplierId    String
  invoiceNumber String
  invoiceDate   DateTime                 @default(now())
  currency      String                   @default("USD")
  amount        Decimal                  @db.Decimal(18, 2)
  status        JmmSupplierInvoiceStatus @default(EXPECTED)
  notes         String                   @default("")
  fileName      String                   @default("")
  storageKey    String                   @default("")
  contentType   String                   @default("")
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  order     JmmOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier  JmmSupplier   @relation(fields: [supplierId], references: [id])
  shipments JmmShipment[]

  @@index([orderId])
  @@index([supplierId])
  @@index([status])
  @@map("jmm_supplier_invoices")
}

model JmmShipment {
  id               String    @id @default(cuid())
  invoiceId        String
  reference        String    @default("")
  shipper          String    @default("")
  consignee        String    @default("")
  carrier          String    @default("")
  incoterm         String    @default("")
  portOfLoading    String    @default("")
  portOfDischarge  String    @default("")
  etd              DateTime?
  eta              DateTime?
  notes            String    @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  invoice JmmSupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  files   JmmShipmentFile[]

  @@index([invoiceId])
  @@map("jmm_shipments")
}

model JmmShipmentFile {
  id          String             @id @default(cuid())
  shipmentId  String
  kind        JmmShipmentDocKind
  fileName    String
  storageKey  String
  contentType String
  createdAt   DateTime           @default(now())

  shipment JmmShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("jmm_shipment_files")
}
