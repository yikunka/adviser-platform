generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum ProcessTestType {
  PERFORMANCE // 性能测试
  DURABILITY // 耐久性测试
  ADHESION // 附着力测试
  COLOR_STABILITY // 色牢度测试
  BOND_STRENGTH // 粘结强度测试
  OTHER // 其他
}

enum ProcessTestResult {
  PASSED // 通过
  FAILED // 未通过
  PENDING // 待测试
}

enum UserRole {
  CLIENT
  STAFF
  COMPLIANCE
  SUPER_ADMIN
}

enum Platform {
  ADVISER
  SFS_DIAMOND
  JMM_TRADING
}

enum JmmDocumentKind {
  QUOTATION
  PROFORMA
  COMMERCIAL_INVOICE
}

enum JmmDocumentStatus {
  DRAFT
  ACCEPTED
  CANCELLED
}

enum JmmSupplierInvoiceStatus {
  EXPECTED
  RECEIVED
  CHECKED
  PAID
}

enum JmmShipmentDocKind {
  BILL_OF_LADING
  AIRWAY_BILL
  PACKING_LIST
  SUPPLIER_INVOICE
  CERTIFICATE_OF_ORIGIN
  INSURANCE
  INSPECTION
  OTHER
}

enum JmmOrderStatus {
  DRAFT
  CONFIRMED
  SHIPPED
  COMPLETED
  CANCELLED
}

/// Online SFS self-registration must be approved before the client can view order/dashboard details.
enum AccountApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  DEREGISTERED
}

enum CompanyFileAssetType {
  COMPANY_BOX
  COMPANY_SQUARE_SEAL
  COMPANY_ROUND_SEAL
}

enum CompanyFileMovementType {
  IN
  OUT
}

enum KYCStatus {
  DRAFT
  APPROVED
  REJECTED
  INACTIVE
}

enum DocumentType {
  CI
  BR
  AA
  NNC1
  ROD
  ROM
  ROSC
  AR
  NAR1
  AUDIT_TAX
  DDR
  RESOLUTION
  MINUTES
  KYC
  OTHER
}

enum AMLEntityType {
  INDIVIDUAL
  ENTITY
}

enum AMLListFormat {
  XML
  CSV
  XLSX
  JSON
}

enum AMLCheckResult {
  CLEAR
  WEAK_HIT
  POTENTIAL_HIT
  STRONG_HIT
}

enum AMLCheckTrigger {
  SCHEDULED
  MANUAL
  KYC_SUBMIT
}

/// Which list family a check was run against (four-step KYC review).
enum AMLScreenScope {
  SANCTIONS
  FATF
  PEP
  /// Manual adverse-media review (no Google API required)
  ADVERSE_MEDIA
  /// Legacy combined screen (sanctions + FATF records together)
  FULL
}

enum AMLAlertResolution {
  PENDING
  FALSE_POSITIVE
  CONFIRMED
  ESCALATED
  /// Reject / terminate relationship — no EDD
  REJECTED
}

enum AMLSubjectType {
  KEY_PERSON
  COMPANY
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum DDRRecommendation {
  RECOMMEND
  NOT_RECOMMEND
  FURTHER_REVIEW
}

enum ShareholderChangeType {
  TRANSFER
  NEW_ALLOTMENT
  REDEMPTION
  NAME_CHANGE
}

enum ShareClass {
  ORDINARY
  PREFERENCE
  OTHER
}

enum ShareTransactionType {
  ALLOTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum DirectorIDType {
  HKID
  PASSPORT
  OTHER
}

enum DirectorStatus {
  ACTIVE
  CEASED
}

enum MemberStatus {
  ACTIVE
  TRANSFERRED_OUT
}

enum ChangeStatus {
  PENDING
  PROCESSING
  COMPLETED
}

enum FilingStatus {
  NOT_STARTED
  IN_PREPARATION
  FILED
  OVERDUE
}

enum OrderType {
  INCORPORATION
  REGISTERED_ADDRESS
  ANNUAL_RETURN
  ACCOUNTING
  ADVISORY
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum NotificationType {
  KYC_STATUS_CHANGE
  AML_ALERT
  ANNUAL_RETURN_DUE
  DOCUMENT_READY
  GENERAL
}

enum EmploymentStatus {
  EMPLOYED
  SELF_EMPLOYED
  RETIRED
  UNEMPLOYED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

enum InvoiceLineDiscountType {
  PERCENT
  FIXED
}

enum InvoiceCustomerType {
  COMPANY
  INDIVIDUAL
}

enum AdvProjectType {
  COMPANY_INCORPORATION
  CORPORATE_SECRETARIAL
  ACCOUNTING
  OTHER
}

enum AdvProjectStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
  RENEWED
}

enum AdvProjectTaskStatus {
  OPEN
  DONE
  CANCELLED
}

// ─────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  passwordHash   String
  nameEn         String
  nameZh         String?
  phone          String?
  mailingAddress String?
  role           UserRole   @default(CLIENT)
  platform       Platform   @default(ADVISER)
  /// Admin Console: which commercial platforms this staff user may operate.
  adminPlatforms Platform[] @default([])
  /// Admin Console: granular menu keys (see src/lib/auth/admin-access.ts).
  adminMenuKeys  String[]   @default([])
  isActive       Boolean    @default(true)
  emailVerified  DateTime?
  /// SFS_DIAMOND self-registered accounts start PENDING until staff approve access to order details.
  /// Non-SFS users and admin-provisioned accounts use APPROVED.
  accountApprovalStatus AccountApprovalStatus @default(APPROVED)
  accountApprovedAt     DateTime?
  accountApprovedById   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  verificationTokens                  VerificationToken[]
  clientCompanies                     Company[]                     @relation("ClientCompany")
  assignedCompanies                   Company[]                     @relation("AssignedStaff")
  companyStaffAssignments             CompanyStaffAssignment[]
  createdCompanyStaffAssignments      CompanyStaffAssignment[]      @relation("CompanyStaffAssignmentCreator")
  createdCompanyFileManagementRecords CompanyFileManagementRecord[] @relation("CompanyFileManagementRecordCreator")
  financialManagedCompanies           Company[]                     @relation("FinancialManager")
  uploadedFinancialHistoryBooks       FinancialHistoryLedgerBook[]  @relation("FinancialHistoryLedgerBookUploader")
  uploadedHistoricalInvoices          HistoricalInvoiceFile[]       @relation("HistoricalInvoiceFileUploader")
  uploadedAdviserContracts            AdviserContract[]             @relation("AdviserContractUploader")
  uploadedAdviserForms                AdviserForm[]                 @relation("AdviserFormUploader")
  createdAdvWorkTasks                 AdvWorkTask[]                 @relation("AdvWorkTaskCreator")
  createdTcspServicePrices            TcspServicePrice[]            @relation("TcspServicePriceCreator")
  updatedTcspServicePrices            TcspServicePrice[]            @relation("TcspServicePriceUpdater")
  createdAdvProjects                  AdvProject[]                  @relation("AdvProjectCreator")
  createdAdvProjectTasks              AdvProjectTask[]              @relation("AdvProjectTaskCreator")
  completedAdvProjectTasks            AdvProjectTask[]              @relation("AdvProjectTaskCompleter")
  uploadedDocuments                   Document[]
  kycReviews                          KeyPerson[]                   @relation("KYCReviewer")
  kycSubmissions                      KeyPerson[]                   @relation("ClientKycSubmissions")
  amlChecksTriggered                  AMLCheck[]                    @relation("AMLCheckTrigger")
  amlAlertsReviewed                   AMLAlert[]                    @relation("AMLAlertReviewer")
  adverseMediaReviewed                AdverseMediaFinding[]         @relation("AdverseMediaReviewer")
  auditLogs                           AuditLog[]
  notifications                       Notification[]
  processedChanges                    ShareholderChange[]
  processedAddress                    AddressChange[]
  processedFilings                    AnnualFiling[]
  orders                              ServiceOrder[]
  sfsOrders                           SfsOrder[]
  sfsCustomers                        SfsCustomer[]                 @relation("SfsCustomerUser")
  sfsPendingDesignUploads             SfsPendingDesignUpload[]
  sfsCustomersCreated                 SfsCustomer[]                 @relation("SfsCustomerCreator")
  financialJournalEntries             JournalEntry[]                @relation("FinancialJournalCreatedBy")
  invoicesCreated                     Invoice[]                     @relation("InvoiceCreatedBy")
  sfsInvoicesCreated                  SfsInvoice[]                  @relation("SfsInvoiceCreatedBy")
  jmmOrdersCreated                    JmmOrder[]                    @relation("JmmOrderCreatedBy")
  sfsStepAttachmentsReviewed          SfsOrderStepAttachment[]      @relation("SfsStepAttachmentReviewer")

  fiscalPeriodsClosed    FiscalPeriod[]       @relation("FiscalPeriodClosedBy")
  salesInvoicesCreated   SalesInvoice[]       @relation("SalesInvoiceCreatedBy")
  purchaseBillsCreated   PurchaseBill[]       @relation("PurchaseBillCreatedBy")
  finPaymentsCreated     FinPayment[]         @relation("FinPaymentCreatedBy")
  finCreditNotesCreated  FinCreditNote[]      @relation("FinCreditNoteCreatedBy")
  bankStatementsImported BankStatement[]      @relation("BankStatementImportedBy")
  bankReconsCreated      BankReconciliation[] @relation("BankReconCreatedBy")

  featureRequests              FeatureRequest[]      @relation("FeatureRequestSubmitter")
  sfsCustomerContractsUploaded SfsCustomerContract[] @relation("SfsCustomerContractUploader")

  /// Dynamic RBAC role assignments (multi-role, union of all permissions)
  adminRoles UserAdminRole[]

  @@map("users")
}

model AdminRole {
  id          String          @id @default(cuid())
  name        String          @unique
  description String          @default("")
  color       String          @default("#6b7280")
  /// All permission strings: page keys (e.g. 'companies') + action keys (e.g. 'companies.create')
  permissions String[]        @default([])
  /// System roles cannot be deleted
  isSystem    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  users       UserAdminRole[]

  @@map("admin_roles")
}

model UserAdminRole {
  userId String
  roleId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_admin_roles")
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
}

// ─────────────────────────────────────────────
// COMPANIES
// ─────────────────────────────────────────────

model Company {
  id                    String        @id @default(cuid())
  nameEn                String
  nameZh                String?
  companyNumber         String?       @unique
  companyType           String?
  companyLegalType      String?
  companyCode           String?       @unique
  dateOfIncorporation   DateTime?
  registeredAddress     String?
  businessNature        String?
  financialYearEndMonth Int?
  businessRegNumber     String?
  brExpiryDate          DateTime?
  status                CompanyStatus @default(ACTIVE)
  /// Multi-select services: COMP_SET_UP, COMP_SECRETARY, VIRTUAL_OFFICE, ACCT_SERVICE, OTHER_SERVICE
  serviceTiers          String[]      @default([])
  financialEnabled      Boolean       @default(true)
  internalNotes         String?
  deletedAt             DateTime?
  clientUserId          String?
  /// Lowercased email: company is pre-assigned until a CLIENT registers with this email
  pendingClientEmail    String?
  assignedStaffId       String?
  financialManagerId    String?
  hasCompanyBox         Boolean       @default(false)
  hasCompanySquareSeal  Boolean       @default(false)
  hasCompanyRoundSeal   Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  clientUser       User? @relation("ClientCompany", fields: [clientUserId], references: [id])
  assignedStaff    User? @relation("AssignedStaff", fields: [assignedStaffId], references: [id])
  financialManager User? @relation("FinancialManager", fields: [financialManagerId], references: [id], onDelete: SetNull)

  directors              Director[]
  members                Member[]
  linkedAsMembers        Member[]                      @relation("MemberLinkedCompany")
  significantControllers SignificantController[]
  linkedAsControllers    SignificantController[]       @relation("ControllerLinkedCompany")
  designatedReps         DesignatedRepresentative[]
  documents              Document[]
  fileCases              CompanyFileCase[]
  fileManagementRecords  CompanyFileManagementRecord[]
  amlChecks              AMLCheck[]                    @relation("CompanyAMLCheck")
  adverseMediaFindings   AdverseMediaFinding[]         @relation("CompanyAdverseMedia")
  dueDiligenceReports    DueDiligenceReport[]
  riskAssessments        RiskAssessmentAnswer[]
  annualFilings          AnnualFiling[]
  shareholderChanges     ShareholderChange[]
  addressChanges         AddressChange[]
  keyPersonLinks         CompanyKeyPerson[]
  serviceOrders          ServiceOrder[]
  advProjects            AdvProject[]
  workTasks              AdvWorkTask[]
  auditLogs              AuditLog[]                    @relation("CompanyAuditLog")
  finAccounts            FinAccount[]
  journalEntries         JournalEntry[]
  ledgerEntries          Ledger[]
  invoices               Invoice[]
  staffAssignments       CompanyStaffAssignment[]
  parties                Party[]
  fiscalPeriods          FiscalPeriod[]
  accountMappings        AccountMapping[]
  reportSectionMappings  FinancialReportSectionMapping[]
  docSequences           DocSequence[]
  salesInvoices          SalesInvoice[]
  purchaseBills          PurchaseBill[]
  finPayments            FinPayment[]
  finCreditNotes         FinCreditNote[]
  bankAccounts           BankAccount[]
  financialHistoryBooks  FinancialHistoryLedgerBook[]

  @@index([pendingClientEmail])
  @@index([financialManagerId])
  @@map("companies")
}

model CompanyFileManagementRecord {
  id           String                  @id @default(cuid())
  companyId    String
  assetType    CompanyFileAssetType
  movementType CompanyFileMovementType
  movementDate DateTime
  handler      String
  notes        String?
  createdById  String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("CompanyFileManagementRecordCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, assetType, movementDate])
  @@index([createdById])
  @@map("company_file_management_records")
}

/// Staff users who can operate a company. This augments legacy Company.assignedStaffId.
model CompanyStaffAssignment {
  id          String   @id @default(cuid())
  companyId   String
  userId      String
  createdById String?
  createdAt   DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("CompanyStaffAssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([companyId, userId])
  @@index([userId])
  @@index([createdById])
  @@map("company_staff_assignments")
}

// ─────────────────────────────────────────────
// REGISTER OF DIRECTORS (ROD)
// ─────────────────────────────────────────────

model Director {
  id                String          @id @default(cuid())
  companyId         String
  keyPersonId       String?
  nameEn            String
  nameZh            String?
  dateOfAppointment DateTime
  dateAsReserve     DateTime?
  dateOfCessation   DateTime?
  addressForService String
  dateOfBirth       DateTime?
  placeOfBirth      String?
  nationality       String?
  idType            DirectorIDType?
  idNumber          String?
  countryOfIssuance String?
  isCorporation     Boolean         @default(false)
  corpRegNumber     String?
  corpRegPlace      String?
  status            DirectorStatus  @default(ACTIVE)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  keyPerson KeyPerson? @relation(fields: [keyPersonId], references: [id], onDelete: SetNull)

  @@index([keyPersonId])
  @@map("directors")
}

// ─────────────────────────────────────────────
// REGISTER OF MEMBERS (ROM)
// ─────────────────────────────────────────────

model Member {
  id                String       @id @default(cuid())
  companyId         String
  keyPersonId       String?
  /// Corporate shareholder: link to another company in the portfolio (mutually exclusive with keyPersonId in UI)
  linkedCompanyId   String?
  nameEn            String
  nameZh            String?
  shareClass        ShareClass   @default(ORDINARY)
  registeredAddress String
  occupation        String?
  status            MemberStatus @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  keyPerson         KeyPerson?         @relation(fields: [keyPersonId], references: [id], onDelete: SetNull)
  linkedCompany     Company?           @relation("MemberLinkedCompany", fields: [linkedCompanyId], references: [id], onDelete: SetNull)
  shareTransactions ShareTransaction[]

  @@index([keyPersonId])
  @@index([linkedCompanyId])
  @@map("members")
}

model ShareTransaction {
  id                           String               @id @default(cuid())
  memberId                     String
  transactionType              ShareTransactionType
  transactionDate              DateTime
  allotmentTransferNo          String?
  sharesAcquired               Int?
  sharesTransferred            Int?
  sharesHeld                   Int
  certificateNo                String?
  distinctiveNosFrom           Int?
  distinctiveNosTo             Int?
  amountPaid                   Decimal?             @db.Decimal(18, 2)
  certificateSurrendered       String?
  certificateSurrenderedShares Int?
  balanceCertificateNo         String?
  balanceCertificateShares     Int?
  balanceDistinctiveNosFrom    Int?
  balanceDistinctiveNosTo      Int?
  createdAt                    DateTime             @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("share_transactions")
}

// ─────────────────────────────────────────────
// REGISTER OF SIGNIFICANT CONTROLLERS (ROSC)
// ─────────────────────────────────────────────

model SignificantController {
  id                    String          @id @default(cuid())
  companyId             String
  keyPersonId           String?
  /// Legal-entity controller: link to another company in the portfolio
  linkedCompanyId       String?
  entryDate             DateTime
  nameEn                String
  nameZh                String?
  correspondenceAddress String?
  idType                DirectorIDType?
  idPassportNo          String?
  issuingCountry        String?
  natureOfControl       String?
  becomingDate          DateTime
  cessationDate         DateTime?
  isLegalEntity         Boolean         @default(false)
  legalEntityRegNo      String?
  legalEntityGovLaw     String?
  remarks               String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  keyPerson     KeyPerson? @relation(fields: [keyPersonId], references: [id], onDelete: SetNull)
  linkedCompany Company?   @relation("ControllerLinkedCompany", fields: [linkedCompanyId], references: [id], onDelete: SetNull)

  @@index([keyPersonId])
  @@index([linkedCompanyId])
  @@map("significant_controllers")
}

model DesignatedRepresentative {
  id            String    @id @default(cuid())
  companyId     String
  keyPersonId   String?
  entryDate     DateTime
  name          String
  address       String?
  capacity      String?
  telFax        String?
  becomingDate  DateTime
  cessationDate DateTime?
  remarks       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  keyPerson KeyPerson? @relation(fields: [keyPersonId], references: [id], onDelete: SetNull)

  @@index([keyPersonId])
  @@map("designated_representatives")
}

// ─────────────────────────────────────────────
// KEY PERSONS & KYC
// ─────────────────────────────────────────────

model KeyPerson {
  id                 String            @id @default(cuid())
  kycCode            String?           @unique @map("kyc_code")
  /// Client who created this KYC (portal); distinct from company-linked key persons
  submittedByUserId  String?
  titlePrefix        String?
  firstName          String?
  lastName           String?
  otherName          String?
  nameEn             String
  nameZh             String?
  idType             String?
  idNumber           String?
  placeOfIssue       String?
  placeOfBirth       String?
  idExpiryDate       DateTime?
  dateOfBirth        DateTime?
  nationality        String?
  homeAddress        String?
  contactAddress     String?
  homePhone          String?
  workPhone          String?
  mobile             String?
  wechat             String?
  email              String?
  isUsCitizen        Boolean?
  isPep              Boolean?
  emergencyContact   String?
  employmentStatus   EmploymentStatus?
  employerName       String?
  employerAddress    String?
  businessNatures    String[]
  position           String?
  workingYears       Int?
  sourceOfFunds      String?
  sourcesOfWealth    String[]
  annualIncome       String?
  netAssetValue      String?
  assetItems         String[]
  declarationSigned  Boolean           @default(false)
  signatureName      String?
  declarationDate    DateTime?
  kycStatus          KYCStatus         @default(DRAFT)
  kycApprovedById    String?
  kycApprovedAt      DateTime?
  kycExpiryDate      DateTime?
  kycRejectionReason String?
  amlLastChecked     DateTime?
  amlRiskLevel       RiskLevel?
  amlAlert           Boolean           @default(false)
  /// Staff-only free-text notes (info not present on uploaded documents)
  adminNotes         String?           @map("admin_notes")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  submittedByUser        User?                   @relation("ClientKycSubmissions", fields: [submittedByUserId], references: [id])
  kycApprovedBy          User?                   @relation("KYCReviewer", fields: [kycApprovedById], references: [id])
  kycDocuments           KYCDocument[]
  companyLinks           CompanyKeyPerson[]
  invoices               Invoice[]
  advProjects            AdvProject[]
  amlChecks              AMLCheck[]              @relation("KeyPersonAMLCheck")
  adverseMediaFindings   AdverseMediaFinding[]   @relation("KeyPersonAdverseMedia")
  directors              Director[]
  members                Member[]
  significantControllers SignificantController[]
  designatedReps         DesignatedRepresentative[]

  @@index([submittedByUserId])
  @@map("key_persons")
}

model KYCDocument {
  id              String    @id @default(cuid())
  keyPersonId     String
  documentType    String
  fileName        String
  storageKey      String
  mimeType        String
  fileSize        Int
  status          String    @default("PENDING")
  rejectionReason String?
  uploadedAt      DateTime  @default(now())
  verifiedAt      DateTime?

  keyPerson KeyPerson @relation(fields: [keyPersonId], references: [id], onDelete: Cascade)

  @@map("kyc_documents")
}

model CompanyKeyPerson {
  id          String   @id @default(cuid())
  companyId   String
  keyPersonId String
  roles       String[]
  createdAt   DateTime @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  keyPerson KeyPerson @relation(fields: [keyPersonId], references: [id], onDelete: Cascade)

  @@unique([companyId, keyPersonId])
  @@map("company_key_persons")
}

// ─────────────────────────────────────────────
// DOCUMENTS
// ─────────────────────────────────────────────

model Document {
  id                 String       @id @default(cuid())
  companyId          String?
  documentType       DocumentType
  name               String
  storageKey         String
  mimeType           String
  fileSize           Int
  uploadedById       String
  fileCaseId         String?
  caseFileRole       String?
  customDocumentType String?
  effectiveDate      DateTime?
  submissionDate     DateTime?
  expiryDate         DateTime?
  version            Int          @default(1)
  notes              String?
  deletedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  company    Company?         @relation(fields: [companyId], references: [id])
  uploadedBy User             @relation(fields: [uploadedById], references: [id])
  fileCase   CompanyFileCase? @relation(fields: [fileCaseId], references: [id], onDelete: SetNull)

  shareholderChangeDocs ShareholderChangeDocument[]
  addressChangeDocs     AddressChangeDocument[]
  annualFilingDocs      AnnualFilingDocument[]

  @@map("documents")
}

model CompanyFileCase {
  id        String    @id @default(cuid())
  companyId String
  name      String
  caseDate  DateTime?
  remark    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([companyId])
  @@map("company_file_cases")
}

// ─────────────────────────────────────────────
// AML ENGINE
// ─────────────────────────────────────────────

model AMLSource {
  id          String        @id @default(cuid())
  seqNo       Int           @unique
  nameEn      String
  nameZh      String
  sourceUrl   String
  format      AMLListFormat
  isActive    Boolean       @default(true)
  lastFetched DateTime?
  createdAt   DateTime      @default(now())

  records AMLRecord[]

  @@map("aml_sources")
}

model AMLRecord {
  id              String        @id @default(cuid())
  sourceId        String
  listVersionDate DateTime
  entityType      AMLEntityType
  primaryName     String
  aliases         String[]
  dateOfBirth     DateTime?
  nationality     String?
  gender          String?
  placeOfBirth    String?
  addresses       Json?
  idNumbers       Json?
  listingReason   String?
  listingDate     DateTime?
  rawData         Json?
  recordHash      String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  source    AMLSource  @relation(fields: [sourceId], references: [id])
  amlAlerts AMLAlert[]

  @@unique([sourceId, recordHash])
  @@index([primaryName])
  @@map("aml_records")
}

model AMLCheck {
  id            String          @id @default(cuid())
  subjectType   AMLSubjectType
  keyPersonId   String?
  companyId     String?
  checkedAt     DateTime        @default(now())
  trigger       AMLCheckTrigger
  triggeredById String?
  result        AMLCheckResult
  /// SANCTIONS | FATF | PEP | FULL — used to gate three-step KYC review
  scope         AMLScreenScope  @default(FULL)
  matches       Json?

  keyPerson   KeyPerson? @relation("KeyPersonAMLCheck", fields: [keyPersonId], references: [id])
  company     Company?   @relation("CompanyAMLCheck", fields: [companyId], references: [id])
  triggeredBy User?      @relation("AMLCheckTrigger", fields: [triggeredById], references: [id])

  @@index([keyPersonId, scope, checkedAt])
  @@index([companyId, scope, checkedAt])
  @@map("aml_checks")
}

model AMLAlert {
  id           String             @id @default(cuid())
  amlRecordId  String
  subjectType  AMLSubjectType
  keyPersonId  String?
  companyId    String?
  matchScore   Float?
  result       AMLCheckResult
  resolution   AMLAlertResolution @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?
  /// Optional supporting evidence uploaded when resolving a hit (e.g. PEP false-positive memo)
  evidenceStorageKey String?
  evidenceFileName   String?
  evidenceMimeType   String?
  evidenceFileSize   Int?
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  amlRecord  AMLRecord @relation(fields: [amlRecordId], references: [id])
  reviewedBy User?     @relation("AMLAlertReviewer", fields: [reviewedById], references: [id])

  @@map("aml_alerts")
}

/// Google CSE adverse-media / negative-news hits (crime, PEP, financial fraud).
model AdverseMediaFinding {
  id             String              @id @default(cuid())
  subjectType    AMLSubjectType
  /// Stable key for dedupe: `kp:<id>` or `co:<id>`
  subjectKey     String
  keyPersonId    String?
  companyId      String?
  query          String
  title          String
  snippet        String?
  url            String
  urlHash        String
  publisher      String?
  source         String              @default("GOOGLE")
  /// Categories e.g. CRIME, PEP, FINANCIAL_FRAUD
  categories     String[]
  relevanceScore Float?
  resolution     AMLAlertResolution  @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNotes    String?
  rawData        Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  keyPerson  KeyPerson? @relation("KeyPersonAdverseMedia", fields: [keyPersonId], references: [id], onDelete: Cascade)
  company    Company?   @relation("CompanyAdverseMedia", fields: [companyId], references: [id], onDelete: Cascade)
  reviewedBy User?      @relation("AdverseMediaReviewer", fields: [reviewedById], references: [id])

  @@unique([subjectKey, urlHash])
  @@index([keyPersonId])
  @@index([companyId])
  @@index([resolution])
  @@map("adverse_media_findings")
}

