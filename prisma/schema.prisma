// ─────────────────────────────────────────────
// SFS DIAMOND — ORDERS
// ─────────────────────────────────────────────

enum SfsOrderStatus {
  PENDING
  QUOTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum SfsDiamondSpecCategory {
  COLOR
  CARAT
  SHAPE
  SETTING_TYPE
  RING_DESIGN
  NECKLACE_DESIGN
  EARRING_DESIGN
  BRACELET_DESIGN
  METAL
}

enum SfsOrderStepAttachmentReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model SfsOrder {
  id        String         @id @default(cuid())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  status    SfsOrderStatus @default(PENDING)

  // Linked user
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Linked SFS customer profile (may be a registered account or a manual customer)
  customerId String?
  customer   SfsCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Part 1 — Client Information
  date           String
  sampleCode     String?
  memorialName   String
  relationship   String
  clientName     String
  contactNumber  String
  email          String
  mailingAddress String

  // Part 2 — Source Material
  sourceType     String
  sourceOther    String?
  remarks        String?
  mailingPackage String

  // Part 3 — Color
  color String

  // Part 4 & 5 — Diamond line items
  diamonds Json

  // Milestone dates (set by admin)
  sampleReceivedAt      DateTime?
  chemTransformStartAt  DateTime?
  chemTransformEndAt    DateTime?
  cvdStartAt            DateTime?
  cvdExpectedEndAt      DateTime?
  cvdEndAt              DateTime?
  craftingStartAt       DateTime?
  craftingEndAt         DateTime?
  igiCertificationAt    DateTime?
  jewelrySettingStartAt DateTime?
  jewelrySettingEndAt   DateTime?
  packagingAt           DateTime?
  deliveryAt            DateTime?
  deliveryDetails       String?

  // Admin notes
  adminNotes     String?
  customerRemark String?

  // Customer-entered internal reference (editable by the client at any time)
  customerInternalOrderCode String?

  steps    SfsOrderStep[]
  invoices SfsInvoice[]

  @@index([userId])
  @@index([customerId])
  @@index([email])
  @@index([status, createdAt])
  @@map("sfs_orders")
}

model SfsCustomer {
  id             String   @id @default(cuid())
  userId         String?  @unique
  name           String
  email          String?
  phone          String?
  mailingAddress String?
  notes          String?
  // Customer-wide discount applied to the final computed unit price (e.g. 0.10 = 10% off). Null = none.
  discountRate   Decimal? @db.Decimal(5, 4)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User?                       @relation("SfsCustomerUser", fields: [userId], references: [id], onDelete: SetNull)
  createdBy      User?                       @relation("SfsCustomerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  orders         SfsOrder[]
  contracts      SfsCustomerContract[]
  priceOverrides SfsCustomerPriceOverride[]

  @@index([email])
  @@index([createdAt])
  @@map("sfs_customers")
}

/// Per-customer base-price override for a specific spec option (category + value).
/// When present it replaces the global SfsDiamondSpecOption.price for that customer.
model SfsCustomerPriceOverride {
  id         String                 @id @default(cuid())
  customerId String
  category   SfsDiamondSpecCategory
  value      String
  price      Decimal                @db.Decimal(18, 2)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  customer SfsCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, category, value])
  @@index([customerId])
  @@map("sfs_customer_price_overrides")
}

model SfsCustomerContract {
  id           String   @id @default(cuid())
  customerId   String
  fileName     String
  storageKey   String
  mimeType     String
  fileSize     Int
  notes        String?
  uploadedById String
  createdAt    DateTime @default(now())

  customer   SfsCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  uploadedBy User        @relation("SfsCustomerContractUploader", fields: [uploadedById], references: [id])

  @@index([customerId])
  @@map("sfs_customer_contracts")
}

model SfsOrderStep {
  id         String   @id @default(cuid())
  orderId    String
  phase      String // CHEM_TRANSFORM | CVD | CRAFTING | JEWELRY_SETTING
  stepNumber Int
  recordedAt DateTime
  particular String
  notes      String?
  fileKeys   String[]
  createdAt  DateTime @default(now())

  order       SfsOrder                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attachments SfsOrderStepAttachment[]

  @@index([orderId, phase])
  @@map("sfs_order_steps")
}

model SfsOrderStepAttachment {
  id           String                             @id @default(cuid())
  stepId       String
  fileKey      String                             @unique
  fileName     String
  mimeType     String
  fileSize     Int
  reviewStatus SfsOrderStepAttachmentReviewStatus @default(APPROVED)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime                           @default(now())
  updatedAt    DateTime                           @updatedAt

  step       SfsOrderStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  reviewedBy User?        @relation("SfsStepAttachmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([stepId, reviewStatus])
  @@map("sfs_order_step_attachments")
}

model SfsDiamondSpecOption {
  id          String                 @id @default(cuid())
  category    SfsDiamondSpecCategory
  label       String
  value       String
  imageUrl    String?
  // Pricing — meaning depends on category:
  //   CARAT          → diamond base price
  //   COLOR / SHAPE  → additive price adjustment (may be negative)
  //   *_DESIGN       → jewellery design price
  //   METAL          → additive metal price adjustment
  // Null/unset is treated as 0 by the pricing engine.
  price       Decimal?               @db.Decimal(18, 2)
  sortOrder   Int                    @default(0)
  isActive    Boolean                @default(true)
  createdById String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([category, value])
  @@index([category, sortOrder])
  @@map("sfs_diamond_spec_options")
}

/// Order-total diamond-count tiers that grant a discount on the diamond price portion.
model SfsDiamondPriceTier {
  id           String   @id @default(cuid())
  minCount     Int
  maxCount     Int? // null = no upper bound
  discountRate Decimal  @db.Decimal(5, 4) // e.g. 0.05 = 5% off
  sortOrder    Int      @default(0)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sortOrder])
  @@map("sfs_diamond_price_tiers")
}

// ─────────────────────────────────────────────
// SFS DIAMOND — INVOICES
// ─────────────────────────────────────────────

model SfsInvoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  orderId       String?
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime
  dueDate       DateTime?
  currency      String        @default("HKD")
  billToName    String
  billToAddress String?
  billToEmail   String?
  billToPhone   String?
  subtotal      Decimal       @db.Decimal(18, 2)
  taxRate       Decimal       @default(0) @db.Decimal(5, 4)
  taxAmount     Decimal       @default(0) @db.Decimal(18, 2)
  total         Decimal       @db.Decimal(18, 2)
  notes         String?
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order     SfsOrder?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy User                 @relation("SfsInvoiceCreatedBy", fields: [createdById], references: [id])
  lineItems SfsInvoiceLineItem[]

  @@index([orderId])
  @@index([status])
  @@index([issueDate])
  @@map("sfs_invoices")
}

model SfsInvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  sortOrder   Int      @default(0)
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 4)
  weight      Decimal? @db.Decimal(12, 4)
  unitPrice   Decimal  @db.Decimal(18, 2)
  amount      Decimal  @db.Decimal(18, 2)

  invoice SfsInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, sortOrder])
  @@map("sfs_invoice_line_items")
}

// ─────────────────────────────────────────────
// CosmoCoat — PRODUCTS
// ─────────────────────────────────────────────

/// Factory product categories — hierarchical taxonomy (max 3 levels)
model CosTableProductCategory {
  id               String   @id @default(cuid())
  name             String
  description      String   @default("")
  parentCategoryId String?
  slug             String   @unique
  image            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  parent          CosTableProductCategory?  @relation("ProductCategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  children        CosTableProductCategory[] @relation("ProductCategoryHierarchy")
  factoryProducts CosTableFactoryProduct[]

  @@index([parentCategoryId])
  @@index([isActive])
  @@map("cos_table_product_categories")
}

model CosTableProduct {
  id                    String   @id @default(cuid())
  pid                   String   @unique
  type                  String
  title                 String
  teaser                String   @default("")
  detail                String   @db.Text
  imagePath             String
  irCuringTime          Int?     @map("ir_curing_time")
  irCuringTemp          Int?     @map("ir_curing_temp")
  uvCuringIntensity     Decimal? @map("uv_curing_intensity") @db.Decimal(8, 2)
  uvCuringUnit          String?  @map("uv_curing_unit")
  viscosity             Decimal? @map("viscosity") @db.Decimal(10, 3)
  viscosityUnit         String?  @map("viscosity_unit")
  mixingRatio           String?  @map("mixing_ratio")
  compatibleProducts    String?  @map("compatible_products")
  requiresCompatibility Boolean  @default(false) @map("requires_compatibility")
  sortOrder             Int      @default(0)
  isFeatured            Boolean  @default(false)
  isVisible             Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([type, sortOrder])
  @@index([isFeatured, sortOrder])
  @@index([isVisible, sortOrder])
  @@map("cos_table_products")
}

// ─────────────────────────────────────────────
// CosmoCoat — RAW MATERIALS (原料)
// ─────────────────────────────────────────────

model CosTableRawMaterial {
  id             String @id @default(cuid())
  category       String
  attributeCode  String
  productionCode String @unique
  huaxingCode    String @default("")
  name           String

  primarySupplierCode    String   @default("")
  primarySupplierName    String   @default("")
  primaryPackageKg       Decimal? @db.Decimal(12, 2)
  primaryPricePerKg      Decimal? @db.Decimal(12, 4)
  primaryTaxIncluded     String   @default("")
  primaryFreightIncluded String   @default("")
  primaryNotes           String   @default("")

  secondarySupplierCode    String   @default("")
  secondarySupplierName    String   @default("")
  secondaryPackageKg       Decimal? @db.Decimal(12, 2)
  secondaryPricePerKg      Decimal? @db.Decimal(12, 4)
  secondaryTaxIncluded     String   @default("")
  secondaryFreightIncluded String   @default("")
  secondaryNotes           String   @default("")

  // TDS (Technical Data Sheet) and MSDS (Material Safety Data Sheet) file keys
  tdsFileKey  String? @map("tds_file_key")
  msdsFileKey String? @map("msds_file_key")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipeItems          CosTableRecipeItem[]
  colorFormulaItems    CosTableColorFormulaItem[]
  productionOrderItems CosTableProductionOrderItem[]

  @@index([category])
  @@index([attributeCode])
  @@index([name])
  @@map("cos_table_raw_materials")
}

// ─────────────────────────────────────────────
// CosmoCoat — RECIPES (配方)
// ─────────────────────────────────────────────

model CosTableRecipeCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipes CosTableRecipe[]

  @@index([sortOrder])
  @@map("cos_table_recipe_categories")
}

model CosTableRecipe {
  id                          String   @id @default(cuid())
  categoryId                  String
  code                        String   @unique
  name                        String
  batchQuantity               Decimal  @default(100) @db.Decimal(12, 3)
  unitCost                    Decimal? @db.Decimal(12, 4)
  viscosity                   String?
  viscosityUnit               String?  @map("viscosity_unit")
  shelfLifeDays               Int?     @map("shelf_life_days")
  notes                       String   @default("")
  productionSpeedRequirements String   @default("") @map("production_speed_requirements")
  productionTimeRequirements  String   @default("") @map("production_time_requirements")
  packagingRequirements       String   @default("") @map("packaging_requirements")
  productionNotes             String   @default("") @map("production_notes")
  qcTestStandard              String   @default("") @map("qc_test_standard")
  qcTestItems                 String[] @default([]) @map("qc_test_items")
  qcResult                    String   @default("") @map("qc_result")
  /// Cached: true when linked to a factory product directly or as a nested component recipe.
  formulaIsUsed               Boolean  @default(false) @map("formula_is_used")
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  category                        CosTableRecipeCategory        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  items                           CosTableRecipeItem[]
  componentInItems                CosTableRecipeItem[]          @relation("RecipeItemComponent")
  productLinks                    CosTableProductRecipe[]
  currentForProducts              CosTableFactoryProduct[]      @relation("CurrentFactoryRecipe")
  productionOrders                CosTableProductionOrder[]
  componentInProductionOrderItems CosTableProductionOrderItem[] @relation("ProductionOrderItemComponentRecipe")
  sourceColorFormulas             CosTableColorFormula[]
  changeRequests                  CosTableRecipeChangeRequest[]

  @@index([categoryId, name])
  @@map("cos_table_recipes")
}

enum CosTableRecipeChangeAction {
  UPDATE
  DELETE
}

enum CosTableRecipeChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model CosTableRecipeChangeRequest {
  id            String                            @id @default(cuid())
  recipeId      String
  action        CosTableRecipeChangeAction
  payload       Json?
  status        CosTableRecipeChangeRequestStatus @default(PENDING)
  requestNote   String                            @default("")
  reviewNote    String                            @default("")
  requestedById String
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime                          @default(now())
  updatedAt     DateTime                          @updatedAt

  recipe      CosTableRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  requestedBy User           @relation("CosRecipeChangeRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy  User?          @relation("CosRecipeChangeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([recipeId, status])
  @@map("cos_table_recipe_change_requests")
}

model CosTableRecipeItem {
  id                    String   @id @default(cuid())
  recipeId              String
  rawMaterialId         String?
  componentRecipeId     String?
  productSemifinishedId String?
  factoryProductId      String?
  sortOrder             Int      @default(0)
  quantity              Decimal  @db.Decimal(12, 3)
  unitPrice             Decimal? @db.Decimal(12, 4)
  amount                Decimal? @db.Decimal(14, 4)
  percentage            Decimal? @db.Decimal(8, 4)
  notes                 String   @default("")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  recipe              CosTableRecipe               @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  rawMaterial         CosTableRawMaterial?         @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  componentRecipe     CosTableRecipe?              @relation("RecipeItemComponent", fields: [componentRecipeId], references: [id], onDelete: Restrict)
  productSemifinished CosTableProductSemifinished? @relation(fields: [productSemifinishedId], references: [id], onDelete: Restrict)
  factoryProduct      CosTableFactoryProduct?      @relation(fields: [factoryProductId], references: [id], onDelete: Restrict)

  @@index([recipeId, sortOrder])
  @@index([componentRecipeId])
  @@index([productSemifinishedId])
  @@index([factoryProductId])
