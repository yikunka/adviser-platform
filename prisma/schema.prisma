// ─────────────────────────────────────────────
// SFS DIAMOND — ORDERS
// ─────────────────────────────────────────────

enum SfsOrderStatus {
  PENDING
  QUOTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum SfsDiamondSpecCategory {
  SOURCE
  COLOR
  CARAT
  SHAPE
  SETTING_TYPE
  RING_DESIGN
  NECKLACE_DESIGN
  EARRING_DESIGN
  BRACELET_DESIGN
  METAL
}

enum SfsOrderStepAttachmentReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model SfsOrder {
  id        String         @id @default(cuid())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  status    SfsOrderStatus @default(PENDING)

  // Linked user
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Linked SFS customer profile (may be a registered account or a manual customer)
  customerId String?
  customer   SfsCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Part 1 — Client Information
  date           String
  sampleCode     String?
  memorialName   String
  relationship   String
  clientName     String
  contactNumber  String
  email          String
  mailingAddress String

  // Part 2 — Source Material
  sourceType     String
  sourceOther    String?
  remarks        String?
  mailingPackage String
  mailingCompany   String?
  mailTrackingCode String?

  // Part 3 — Color
  color String

  // Part 4 & 5 — Diamond line items
  diamonds Json

  // Milestone dates (set by admin)
  packageArrivedHkAt    DateTime?
  sampleReceivedAt      DateTime?
  chemTransformStartAt  DateTime?
  chemTransformEndAt    DateTime?
  cvdStartAt            DateTime?
  cvdExpectedEndAt      DateTime?
  cvdEndAt              DateTime?
  craftingStartAt       DateTime?
  craftingEndAt         DateTime?
  igiCertificationAt    DateTime?
  jewelrySettingStartAt DateTime?
  jewelrySettingEndAt   DateTime?
  packagingAt           DateTime?
  deliveryAt            DateTime?
  deliveryDetails       String?

  // Admin notes
  adminNotes     String?
  customerRemark String?

  // Staff-entered quotation (manual review of custom jewellery designs)
  quotedAmount Decimal?  @db.Decimal(18, 2)
  quotedAt     DateTime?
  quoteNotes   String?

  // Customer-entered internal reference (editable by the client at any time)
  customerInternalOrderCode String?

  /// Per-order production step plan. Null = use global SFS_PREDEFINED_STEPS defaults.
  /// Shape: { [phase: string]: Array<{ id, label, kind: 'default'|'custom', defaultKey?: string }> }
  stepPlan Json?

  steps              SfsOrderStep[]
  invoices           SfsInvoice[]
  designAttachments  SfsOrderDesignAttachment[]

  @@index([userId])
  @@index([customerId])
  @@index([email])
  @@index([status, createdAt])
  @@map("sfs_orders")
}

model SfsOrderDesignAttachment {
  id           String   @id @default(cuid())
  orderId      String
  diamondIndex Int
  storageKey   String
  fileName     String
  mimeType     String
  sizeBytes    Int
  uploadedAt   DateTime @default(now())

  order SfsOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, diamondIndex])
  @@map("sfs_order_design_attachments")
}

/// A private custom-design file uploaded before its SFS order is submitted.
/// The browser receives only this row's id; the OSS key never leaves the server.
model SfsPendingDesignUpload {
  id             String   @id @default(cuid())
  draftTokenHash String
  userId         String?
  storageKey     String   @unique
  fileName       String
  mimeType       String
  sizeBytes      Int
  expiresAt      DateTime
  claimedAt      DateTime?
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([draftTokenHash, expiresAt])
  @@index([userId, expiresAt])
  @@index([claimedAt, expiresAt])
  @@map("sfs_pending_design_uploads")
}

model SfsCustomer {
  id             String   @id @default(cuid())
  userId         String?  @unique
  name           String
  email          String?
  phone          String?
  mailingAddress String?
  /// Partner / distributor company name (from the application form).
  company        String?
  /// Market or region the partner covers.
  market         String?
  /// Expected order volume, free text from the application.
  expectedVolume String?
  /// Assigned territory note set by staff (optional).
  territoryNote  String?
  /// Minimum-order note for this partner's region (optional).
  moqNote        String?
  notes          String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User?                      @relation("SfsCustomerUser", fields: [userId], references: [id], onDelete: SetNull)
  createdBy      User?                      @relation("SfsCustomerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  orders         SfsOrder[]
  contracts      SfsCustomerContract[]
  priceOverrides SfsCustomerPriceOverride[]
  multiDiamondDiscountTiers SfsCustomerMultiDiamondDiscountTier[]

  @@index([email])
  @@index([createdAt])
  @@index([market])
  @@map("sfs_customers")
}

/// Global multi-diamond discount tiers. Discount applies only to the diamond portion
/// (carat + source + color + shape). 10 ⇒ 10% off that portion when diamondCount ≥ minDiamondCount.
model SfsMultiDiamondDiscountTier {
  id              String   @id @default(cuid())
  minDiamondCount Int
  discountPercent Decimal  @db.Decimal(8, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([minDiamondCount])
  @@map("sfs_multi_diamond_discount_tiers")
}

/// Per-customer multi-diamond discount tiers. When any row exists for a customer,
/// those tiers replace the global table for that customer (blank/empty ⇒ use global).
model SfsCustomerMultiDiamondDiscountTier {
  id              String   @id @default(cuid())
  customerId      String
  minDiamondCount Int
  discountPercent Decimal  @db.Decimal(8, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer SfsCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, minDiamondCount])
  @@index([customerId])
  @@map("sfs_customer_multi_diamond_discount_tiers")
}

/// Per-customer base-price override for a specific spec option (category + value).
/// When present it replaces the global SfsDiamondSpecOption.price for that customer.
model SfsCustomerPriceOverride {
  id         String                 @id @default(cuid())
  customerId String
  category   SfsDiamondSpecCategory
  value      String
  price      Decimal                @db.Decimal(18, 2)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  customer SfsCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, category, value])
  @@index([customerId])
  @@map("sfs_customer_price_overrides")
}

model SfsCustomerContract {
  id           String   @id @default(cuid())
  customerId   String
  fileName     String
  storageKey   String
  mimeType     String
  fileSize     Int
  notes        String?
  uploadedById String
  createdAt    DateTime @default(now())

  customer   SfsCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  uploadedBy User        @relation("SfsCustomerContractUploader", fields: [uploadedById], references: [id])

  @@index([customerId])
  @@map("sfs_customer_contracts")
}

model SfsOrderStep {
  id         String   @id @default(cuid())
  orderId    String
  phase      String // CHEM_TRANSFORM | CVD | CRAFTING | JEWELRY_SETTING
  stepNumber Int
  /// Stable id matching an item in SfsOrder.stepPlan (defaultKey or custom cuid)
  planStepId String?
  recordedAt DateTime
  particular String
  notes      String?
  fileKeys   String[]
  createdAt  DateTime @default(now())

  order       SfsOrder                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attachments SfsOrderStepAttachment[]

  @@index([orderId, phase])
  @@index([orderId, planStepId])
  @@map("sfs_order_steps")
}

model SfsOrderStepAttachment {
  id           String                             @id @default(cuid())
  stepId       String
  fileKey      String                             @unique
  fileName     String
  mimeType     String
  fileSize     Int
  reviewStatus SfsOrderStepAttachmentReviewStatus @default(APPROVED)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime                           @default(now())
  updatedAt    DateTime                           @updatedAt

  step       SfsOrderStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  reviewedBy User?        @relation("SfsStepAttachmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([stepId, reviewStatus])
  @@map("sfs_order_step_attachments")
}

model SfsDiamondSpecOption {
  id          String                 @id @default(cuid())
  category    SfsDiamondSpecCategory
  label       String
  value       String
  imageUrl    String?
  /// Default length for necklace and bracelet designs. The order form fills this in and the client can edit it.
  chainLength String?
  // Pricing — meaning depends on category:
  //   CARAT          → diamond base price
  //   SOURCE / COLOR / SHAPE → additive price adjustment (may be negative)
  //   *_DESIGN       → jewellery design price
  //   METAL          → additive metal price adjustment
  // Null/unset is treated as 0 by the pricing engine.
  price       Decimal?               @db.Decimal(18, 2)
  sortOrder   Int                    @default(0)
  isActive    Boolean                @default(true)
  createdById String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([category, value])
  @@index([category, sortOrder])
  @@map("sfs_diamond_spec_options")
}

// ─────────────────────────────────────────────
// SFS DIAMOND — INVOICES
// ─────────────────────────────────────────────

model SfsInvoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  orderId       String?
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime
  dueDate       DateTime?
  currency      String        @default("HKD")
  billToName    String
  billToAddress String?
  billToEmail   String?
  billToPhone   String?
  subtotal      Decimal       @db.Decimal(18, 2)
  taxRate       Decimal       @default(0) @db.Decimal(5, 4)
  taxAmount     Decimal       @default(0) @db.Decimal(18, 2)
