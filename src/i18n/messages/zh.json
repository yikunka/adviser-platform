  "faq": {
    "title": "常見問題",
    "subtitle": "有關香港公司成立及TCSP服務的一切問題。",
    "groupIncorporation": "公司成立",
    "groupCompliance": "合規及KYC",
    "groupServices": "服務及運作",
    "items": {
      "incorporation": {
        "q": "香港公司成立需要多長時間？",
        "a": "標準網上成立需要1–2個工作天。我們提供快速服務，可在同一個工作日完成。"
      },
      "kyc": {
        "q": "KYC需要哪些文件？",
        "a": "我們需要政府發出的附照片身份證明文件（香港身份證或護照）、住址證明（3個月內的水電費單或銀行月結單）及填妥的KYC表格。"
      },
      "annualFiling": {
        "q": "周年申報表何時到期？",
        "a": "周年申報表必須在公司周年成立日後42天內提交。"
      },
      "fees": {
        "q": "香港公司的最低股本是多少？",
        "a": "香港沒有最低股本要求。大多數公司以港幣10,000元成立，分為10,000股，每股面值港幣1元。"
      },
      "timeline": {
        "q": "我需要本地董事嗎？",
        "a": "不需要。香港公司可以有100%外籍董事及股東。但公司秘書必須是香港居民或在香港設有辦事處的公司。"
      },
      "address": {
        "q": "我可以使用虛擬辦公室地址嗎？",
        "a": "可以。我們的高級方案包含在油麻地辦公室的註冊地址服務，用於法定用途。"
      },
      "aml": {
        "q": "什麼是AML篩查，為什麼需要？",
        "a": "作為持牌TCSP，我們根據《打擊洗錢及恐怖分子資金籌集條例》（第615章）的規定，需要對所有客戶及相關人士進行國際制裁名單篩查，並維護持續盡職審查記錄。"
      },
      "documents": {
        "q": "我在哪裡可以下載法定文件（ROD、ROM、ROSC）？",
        "a": "登入後，前往客戶門戶的「文件」頁面。所有生成的法定冊及申報文件均可以DOCX或PDF格式下載。"
      },
      "director": {
        "q": "董事及股東有哪些披露要求？",
        "a": "根據《公司條例》，香港公司須維護董事登記冊及重要控制人登記冊（ROSC）。所有董事及持有重要控制權的實益擁有人須向公司披露其身份，並保持資料更新。"
      },
      "foreign": {
        "q": "香港公司可以100%外資擁有嗎？",
        "a": "可以。香港對外資持股沒有任何限制。公司可以100%由外國個人或機構持有——沒有本地股東或董事的要求。"
      },
      "financialStmt": {
        "q": "私人公司是否需要每年準備財務報表？",
        "a": "是的。所有香港私人公司必須每年準備符合香港財務報告準則（HKFRS）的財務報表。符合特定條件的小型公司可申請簡化申報豁免。"
      },
      "dormant": {
        "q": "可以在沒有實際業務的情況下保持公司登記嗎？",
        "a": "可以。休眠或控股公司可以持續登記，只要維持繳交周年費用及法定申報即可。這常見於持有知識產權、資產或備用用途的公司。"
      },
      "wfoe": {
        "q": "什麼是WFOE？我何時需要成立一家？",
        "a": "外商獨資企業（WFOE）是外資企業在中國內地直接開展業務的最常見架構，適用於需在中國進行業務運作、聘用本地員工或收取人民幣收入的情況。我們提供從諮詢到政府審批的全程支援。"
      },
      "secretary": {
        "q": "香港公司秘書有哪些要求？",
        "a": "每家香港公司必須委任公司秘書。若為個人，須為香港居民；若為法人團體，須在香港設有辦事處或主要營業地點。公司秘書不得同時擔任公司的唯一董事。"
      }
    }
  },
